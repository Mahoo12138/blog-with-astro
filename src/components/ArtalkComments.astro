---
import 'artalk/Artalk.css';

const server = import.meta.env.ARTALK_SERVER ?? '';
const site = import.meta.env.ARTALK_SITE ?? '';
const enabled = Boolean(server && site);

interface Props {
	pageKey?: string;
	pageTitle?: string;
}

const { pageKey, pageTitle } = Astro.props;
---

{enabled && (
	<section class="artalk-section" data-pagefind-ignore>
		<div
			id="artalk"
			class="artalk-mount"
			data-server={server}
			data-site={site}
			data-page-key={pageKey ?? ''}
			data-page-title={pageTitle ?? ''}
		></div>
		<script>
			type ArtalkInstance = { destroy: () => void; setDarkMode: (d: boolean) => void };
			let instance: ArtalkInstance | null = null;
			let ArtalkMod: typeof import('artalk') | null = null;
			let observer: IntersectionObserver | null = null;
			let themeObserver: MutationObserver | null = null;

			const teardown = () => {
				themeObserver?.disconnect();
				themeObserver = null;
				observer?.disconnect();
				observer = null;
				try { instance?.destroy(); } catch {}
				instance = null;
				ArtalkMod = null;
			};

			// 评论区接近视口再 dynamic import Artalk：
			// 一篇长文章如果用户只看前半部分，这次网络 / 解析 / 初始化开销就完全省掉了。
			const initArtalk = async () => {
				const mount = document.getElementById('artalk') as HTMLElement | null;
				if (!mount || instance) return;

				if (!ArtalkMod) ArtalkMod = await import('artalk');
				const Artalk = ArtalkMod.default;

				const root = document.documentElement;
				const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
				const resolveDark = () => {
					const theme = root.getAttribute('data-theme');
					if (theme === 'dark') return true;
					if (theme === 'light') return false;
					return darkQuery.matches;
				};

				instance = Artalk.init({
					el: '#artalk',
					pageKey: mount.dataset.pageKey || location.pathname,
					pageTitle: mount.dataset.pageTitle || document.title,
					server: mount.dataset.server!,
					site: mount.dataset.site!,
					darkMode: resolveDark(),
					locale: 'zh-CN',
				});

				const applyDark = () => {
					try { instance?.setDarkMode(resolveDark()); } catch {}
				};
				themeObserver = new MutationObserver(applyDark);
				themeObserver.observe(root, { attributes: true, attributeFilter: ['data-theme'] });
				darkQuery.addEventListener('change', applyDark);
			};

			const setup = () => {
				const mount = document.getElementById('artalk') as HTMLElement | null;
				if (!mount) return;

				// 每次页面加载注册一次清理（下一次 swap 触发）
				document.addEventListener('astro:before-swap', teardown, { once: true });

				// 评论区距离视口 600px 内再触发懒加载
				if (!observer) {
					observer = new IntersectionObserver(
						(entries) => {
							if (entries[0]?.isIntersecting) {
								observer?.disconnect();
								observer = null;
								void initArtalk();
							}
						},
						{ rootMargin: '600px' },
					);
					observer.observe(mount);
				}
			};

			document.addEventListener('astro:page-load', setup);
		</script>
	</section>
)}

<style>
	.artalk-section {
		margin: 1.5rem 1rem 2rem;
		padding: 1.25rem 1.25rem 0.5rem;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.62);
		border: 1px solid rgba(18, 25, 38, 0.08);
	}

	:global(:root[data-theme='dark']) .artalk-section {
		background: rgba(18, 27, 40, 0.6);
		border-color: rgba(148, 163, 184, 0.16);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .artalk-section {
			background: rgba(18, 27, 40, 0.6);
			border-color: rgba(148, 163, 184, 0.16);
		}
	}

	.artalk-mount {
		min-height: 120px;
	}
</style>
