---
import AvatarImage from '../../assets/avatar.png';
import HeroParticles from './HeroParticles.tsx';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import * as styles from '../../styles/hero.css';
---

<section class={styles.hero}>
	<div class={styles.heroCanvas}>
		<HeroParticles client:load />
	</div>
	<div class={styles.heroContent}>
		<img class={styles.heroAvatar} src={AvatarImage.src} alt={SITE_TITLE} width="120" height="120" />
		<h1 class={styles.heroTitle}>{SITE_TITLE}</h1>
		<p class={styles.heroTagline}>{SITE_DESCRIPTION}</p>
	</div>
	<button class={styles.scrollIndicator} type="button" data-scroll-to-content aria-label="向下滚动查看更多">
		<span>探索</span>
		<svg class={styles.scrollArrow} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
	</button>
</section>

<script is:inline>
	(() => {
		const btn = document.querySelector('[data-scroll-to-content]');
		if (!btn) return;
		btn.addEventListener('click', () => {
			const shell = document.querySelector('[data-stellar-shell]');
			if (shell) {
				shell.scrollIntoView({ behavior: 'smooth' });
			}
		});
	})();
</script>
