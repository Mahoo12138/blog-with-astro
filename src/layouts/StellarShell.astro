---
import BaseHead from '../components/BaseHead.astro';
import AppearanceButton from '../components/AppearanceButton.astro';
import type { ImageMetadata } from 'astro';
import StellarLeftSidebar from '../components/StellarLeftSidebar.astro';
import StellarIcon from '../components/StellarIcon.astro';
import StellarPageFooter from '../components/StellarPageFooter.astro';
import StellarRightSidebar from '../components/StellarRightSidebar.astro';
import TopProgressBar from '../components/TopProgressBar.astro';
import SkipLink from '../components/SkipLink.astro';
import { SITE_TITLE } from '../consts';
import { resolveShellConfig, type MenuId, type SidebarValue, type SiteTreeKey } from '../config/stellar';
import type { ColumnSidebarContext } from '../components/sidebar/types';
import * as styles from './StellarShell.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	mainClass?: string;
	/** 仅无右栏时可使用宽内容区；文章等页面默认保持阅读宽度。 */
	contentWidth?: 'reading' | 'wide';
	siteTree?: SiteTreeKey;
	menuId?: MenuId;
	leftbar?: SidebarValue;
	rightbar?: SidebarValue;
	tocHeadings?: { depth: number; slug: string; text: string }[];
	column?: ColumnSidebarContext;
	noindex?: boolean;
}

const { title, description, lang = 'zh-CN', image, type, publishedTime, modifiedTime, mainClass, contentWidth = 'reading', siteTree = 'page', menuId, leftbar, rightbar, tocHeadings = [], column, noindex = false } = Astro.props;
const hasHero = Astro.slots.has('hero');
const hasLead = Astro.slots.has('lead');
const hasLeftbar = Astro.slots.has('leftbar');
const hasRightbar = Astro.slots.has('rightbar');
const shellConfig = resolveShellConfig(siteTree, { menuId, leftbar, rightbar });
const hasRightbarContent = shellConfig.rightbar.length > 0 || hasRightbar;
const expandContent = contentWidth === 'wide' && !hasRightbarContent;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={image} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} noindex={noindex} />
	</head>
	<body class={styles.body}>
		<TopProgressBar />
		<SkipLink />
		{hasHero && <slot name="hero" />}
		<header class={styles.mobileHeader} data-mobile-header data-pagefind-ignore>
			<a class={styles.mobileTitle} href="/">{SITE_TITLE}</a>
			<div class={styles.mobileTools}>
				<AppearanceButton compact />
				<button class={styles.floatButton} type="button" data-sidebar-toggle="leftbar" aria-controls="site-leftbar" aria-expanded="false" aria-label="打开站点导航">
					<StellarIcon name="default:leftbar" class={styles.floatIcon} />
				</button>
			</div>
		</header>
		<div class:list={[styles.shell, expandContent && styles.wideContent]} data-stellar-shell data-content-width={expandContent ? 'wide' : undefined}>
			<aside id="site-leftbar" class={styles.left} aria-label="站点导航" data-pagefind-ignore>
				<button class:list={[styles.sidebarClose, styles.leftClose]} type="button" data-sidebar-close>关闭导航</button>
				<StellarLeftSidebar menuId={shellConfig.menuId} widgets={shellConfig.leftbar} column={column} />
				{hasLeftbar && <slot name="leftbar" />}
			</aside>
			<main id="main-content" class={styles.mainArea} data-pagefind-body tabindex="-1">
				<div class:list={[styles.mainContent, mainClass]}>
					{hasLead && <div class={styles.lead}><slot name="lead" /></div>}
					<slot />
					<StellarPageFooter />
				</div>
			</main>
			{hasRightbarContent && (
				<aside id="site-rightbar" class={styles.right} aria-label="页面侧栏" data-pagefind-ignore>
					<button class:list={[styles.sidebarClose, styles.rightClose]} type="button" data-sidebar-close>关闭侧栏</button>
					<StellarRightSidebar widgets={shellConfig.rightbar} headings={tocHeadings} column={column} />
					{hasRightbar && <slot name="rightbar" />}
				</aside>
			)}
			<button class={styles.mainMask} type="button" data-sidebar-dismiss tabindex="-1" aria-hidden="true" aria-label="关闭侧栏" data-pagefind-ignore></button>
			<div class={styles.floatPanel} data-pagefind-ignore>
				{hasRightbarContent && (
					<button class:list={[styles.floatButton, styles.rightbarToggle]} type="button" data-sidebar-toggle="rightbar" aria-controls="site-rightbar" aria-expanded="false" aria-label="打开页面侧栏">
						<StellarIcon name="default:rightbar" class={styles.floatIcon} />
					</button>
				)}
				<button class:list={[styles.floatButton, styles.leftbarToggle]} type="button" data-sidebar-toggle="leftbar" aria-controls="site-leftbar" aria-expanded="false" aria-label="打开站点导航">
					<StellarIcon name="default:leftbar" class={styles.floatIcon} />
				</button>
			</div>
		</div>
		<script>
			import '../scripts/sidebar';
		</script>	</body>
</html>