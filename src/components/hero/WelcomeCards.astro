---
/**
 * 第二屏：可配置卡片式导航 grid
 *
 * 布局：左文（欢迎语/标题/技能标签）+ 右卡（WelcomeGrid）
 * 卡片配置在 src/config/welcomeGridConfig.ts
 */
import WelcomeGrid from '../welcome-grid/WelcomeGrid.astro';
import * as styles from '../../styles/welcomeCards.css';
---

<section class={styles.section} data-welcome-cards>
	<div class={styles.container}>
		<aside class={styles.intro}>
			<h2 class={styles.greeting}>
				Hi, 朋友 <span class={styles.wave} aria-hidden="true">👋</span>
			</h2>
			<p class={styles.headline}>欢迎访问我的空间！</p>
			<p class={styles.subline}>这里是静态内容与长期写作的整理地。</p>
			<div class={styles.pills}>
				<span class={styles.pill}>设计</span>
				<span class={styles.pill}>代码</span>
				<span class={styles.pill}>阅读</span>
				<span class={styles.pill}>折腾</span>
			</div>
		</aside>

		<div class={styles.welcomeGridHost}>
			<WelcomeGrid />
		</div>
	</div>
</section>
