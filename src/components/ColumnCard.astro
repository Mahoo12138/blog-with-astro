---
import { postHref, type ColumnBucket } from '../utils/content';
import * as catalog from '../styles/columnsIndex.css';
import * as styles from '../styles/taxonomy.css';

interface Props {
	column: ColumnBucket;
	/**
	 * 卡片上「N 篇」角标的内容。
	 * 默认按章节数显示；分类页 / 标签页上专栏是「一条」条目，
	 * 用章节数正好能说明这个专栏有多长。
	 */
	countLabel?: string;
	/** 专栏首页使用完整目录卡片；分类/标签页保留现有紧凑呈现。 */
	variant?: 'default' | 'catalog';
	index?: number;
}

const { column, countLabel, variant = 'default', index = 1 } = Astro.props;
const count = countLabel ?? `${column.posts.length} 篇`;
const href = `/columns/${column.slug}/`;
const firstPost = column.posts[0];
const titleId = `column-title-${column.slug}`;
---

{variant === 'catalog' ? (
	<article class={catalog.card} data-column-card={column.slug}>
		<div class={catalog.cardMeta}>
			<span class={catalog.number} aria-hidden="true">{String(index).padStart(2, '0')}</span>
			<span class={catalog.count}>{count}</span>
		</div>
		{column.icon && <img class={catalog.icon} src={column.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />}
		<h2 class={catalog.cardTitle} id={titleId}>
			<a class={catalog.overviewLink} href={href} aria-describedby={column.description ? `${titleId}-description` : undefined}>
				{column.title}
			</a>
		</h2>
		{column.description && <p class={catalog.cardDescription} id={`${titleId}-description`}>{column.description}</p>}
		<div class={catalog.cardFooter}>
			<span class={catalog.overviewHint} aria-hidden="true">查看目录</span>
			{firstPost && (
				<a class={catalog.readLink} href={postHref(firstPost)} aria-label={`开始阅读${column.title}：${firstPost.data.title}`} title={firstPost.data.title}>
					<span>开始阅读</span>
					<svg class={catalog.arrow} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
				</a>
			)}
		</div>
	</article>
) : (
<div class={styles.topicCardWrap}>
	<a class={styles.topicCard} href={`/columns/${column.slug}/`}>
		<article class={styles.topicArticle}>
			<div class={styles.topicPreview}>
				{
					column.icon ? (
						<img class={styles.topicImage} src={column.icon} alt="" />
					) : (
						<span class={styles.topicFallback}>{column.title.slice(0, 1)}</span>
					)
				}
			</div>
			<div class={styles.topicExcerpt}>
				<div class={styles.topicCaps}>
					<span class={styles.topicCap}>{count}</span>
				</div>
				<h2 class={styles.topicTitle}>{column.title}</h2>
				{column.description && <p class={styles.topicDescription}>{column.description}</p>}
			</div>
		</article>
	</a>
</div>
)}
