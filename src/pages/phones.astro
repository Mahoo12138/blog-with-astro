---
import { getCollection } from "astro:content";
import { getExploreInternalItemByHref } from "../config/explore";
import ExploreShell from "../layouts/ExploreShell.astro";

const item = getExploreInternalItemByHref("/phones/");
if (!item) {
  throw new Error("Explore item for /phones/ was not found.");
}

const MOWNED_IMAGE_BASE = "https://mowned.com/html/phones/big/";

const entries = await getCollection("phones");

type PhoneEntry = (typeof entries)[number]["data"];

const phones = entries
  .map((e) => e.data)
  .sort((a, b) => {
    if (b.yearFrom !== a.yearFrom) return b.yearFrom - a.yearFrom;
    return a.order - b.order;
  });

const CURRENT_YEAR = 2026;

function deriveStatus(p: PhoneEntry) {
  if (p.yearTo === null && p.isPrimary && p.stillOwn)
    return { key: "primary", label: "现役主力" };
  if (p.yearTo === null && p.stillOwn)
    return { key: "active", label: "仍在使用" };
  if (p.yearTo !== null && p.stillOwn) return { key: "kept", label: "已收藏" };
  return { key: "retired", label: "已退役" };
}

function deriveEra(year: number) {
  if (year >= 2024) return "当代";
  if (year >= 2020) return "5G 时代";
  if (year >= 2017) return "全面屏元年";
  if (year >= 2014) return "安卓黄金期";
  return "功能机末梢";
}

function ownershipYears(p: PhoneEntry) {
  const end = p.yearTo ?? CURRENT_YEAR;
  const span = end - p.yearFrom;
  if (span <= 0) return "不足一年";
  return `${span} 年`;
}

function yearRange(p: PhoneEntry) {
  if (p.yearTo === null) return `${p.yearFrom} — 至今`;
  if (p.yearTo === p.yearFrom) return `${p.yearFrom}`;
  return `${p.yearFrom} — ${p.yearTo}`;
}

const totalCount = phones.length;
const yearMin = Math.min(...phones.map((p) => p.yearFrom));
const yearMax = Math.max(...phones.map((p) => p.yearFrom));
const yearSpan = yearMax - yearMin;
const brandCount = new Set(phones.map((p) => p.brandAlias)).size;
const activeCount = phones.filter((p) => p.yearTo === null).length;
const lovedCount = phones.filter((p) => p.like === "y").length;


const brandSummary = Array.from(
  phones
    .reduce((m, p) => {
      const k = p.brandAlias;
      const cur = m.get(k) ?? { brand: p.brand, count: 0 };
      cur.count += 1;
      m.set(k, cur);
      return m;
    }, new Map<string, { brand: string; count: number }>())
    .values(),
).sort((a, b) => b.count - a.count);
---

<ExploreShell item={item}>
  <div class="phones-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="面包屑导航">
      <a href="/" class="bc-link">首页</a>
      <span class="bc-sep" aria-hidden="true">/</span>
      <a href="/explore/" class="bc-link">探索</a>
      <span class="bc-sep" aria-hidden="true">/</span>
      <span class="bc-current">玩机岁月</span>
    </nav>

    <!-- Header -->
    <header class="page-header">
      <h1 class="page-title">
        <span class="title-icon" aria-hidden="true">📱</span>
        玩机岁月
      </h1>
      <p class="page-desc">
        从一台诺基亚 6230i 开始，<strong>{yearSpan} 年</strong
        >间陪我入眠又被我遗忘的 <strong>{totalCount}</strong> 台手机。 数据来源于
        <a
          href="https://mowned.com/mahoo12138"
          target="_blank"
          rel="noopener noreferrer">mowned.com</a
        >。
      </p>
    </header>

    <!-- Stats ribbon -->
    <section class="stats-card" aria-label="数据汇总">
      <div class="stats-row">
        <div class="stat-cell">
          <span class="stat-num">{totalCount}</span>
          <span class="stat-lbl">总数</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num">{yearSpan}</span>
          <span class="stat-lbl">跨越年份</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num">{brandCount}</span>
          <span class="stat-lbl">品牌</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num accent-warm">{activeCount}</span>
          <span class="stat-lbl">现役</span>
        </div>
        <div class="stat-cell">
          <span class="stat-num accent-warm">{lovedCount}</span>
          <span class="stat-lbl">挚爱</span>
        </div>
      </div>
      <div class="stats-divider" aria-hidden="true"></div>
      <div class="brand-list">
        {
          brandSummary.map((b) => (
            <span class="brand-chip">
              {b.brand}
              <span class="brand-chip-num">×{b.count}</span>
            </span>
          ))
        }
      </div>
    </section>

    <!-- Catalog header -->
    <div class="catalog-head">
      <h2 class="catalog-title">服役年表</h2>
      <span class="catalog-meta">按入手时间倒序 · 共 {totalCount} 部</span>
    </div>

    <!-- Timeline / catalog -->
    <ol class="catalog" reversed>
      {
        phones.map((p, i) => {
          const prev = phones[i - 1];
          const showYearMarker = !prev || prev.yearFrom !== p.yearFrom;
          const status = deriveStatus(p);
          const era = deriveEra(p.yearFrom);
          const ownYears = ownershipYears(p);
          const cardIndex = String(i + 1).padStart(2, "0");
          const imgUrl = `${MOWNED_IMAGE_BASE}${p.imagePath}`;
          return (
            <li
              class={`spec spec-${status.key}`}
              data-year={p.yearFrom}
              style={`--enter-delay: ${Math.min(i * 60, 480)}ms`}
            >
              <div class="spec-axis">
                {showYearMarker ? (
                  <div class="year-stamp">
                    <span class="year-stamp-num">{p.yearFrom}</span>
                  </div>
                ) : (
                  <div class="year-stamp year-stamp-cont" aria-hidden="true">
                    <span class="year-stamp-dot" />
                  </div>
                )}
                <div class="spec-thread" aria-hidden="true" />
              </div>

              <article class="spec-card">
                <div class="spec-card-header">
                  <div class="spec-no">
                    <span class="spec-no-label">No.</span>
                    <span class="spec-no-num">{cardIndex}</span>
                  </div>
                  <div class={`spec-status spec-status-${status.key}`}>
                    <span class="spec-status-dot" aria-hidden="true" />
                    {status.label}
                  </div>
                </div>

                <div class="spec-body">
                  <figure class="spec-figure">
                    <img
                      class="spec-image"
                      src={imgUrl}
                      alt={`${p.brand} ${p.name}`}
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                  </figure>

                  <div class="spec-info">
                    <div class="spec-brand">{p.brand}</div>
                    <h3 class="spec-name">{p.name}</h3>

                    <div class="spec-meta">
                      <div class="spec-meta-row">
                        <span class="spec-meta-lbl">在役</span>
                        <span class="spec-meta-val">{yearRange(p)}</span>
                        <span class="spec-meta-pill">{ownYears}</span>
                      </div>
                      <div class="spec-meta-row">
                        <span class="spec-meta-lbl">发布</span>
                        <span class="spec-meta-val">{p.releaseYear}</span>
                        <span class="spec-meta-era">{era}</span>
                      </div>
                      <div class="spec-meta-row">
                        <span class="spec-meta-lbl">机身</span>
                        <span
                          class="spec-color-swatch"
                          style={`--swatch:${p.color};`}
                          aria-hidden="true"
                        />
                        <span class="spec-meta-val">
                          {p.colorName ?? p.color}
                        </span>
                        <span class="spec-meta-hex">
                          {p.color.toUpperCase()}
                        </span>
                      </div>
                    </div>

                    {p.comment && (
                      <p class="spec-comment">
                        <span class="spec-comment-mark" aria-hidden="true">
                          「
                        </span>
                        {p.comment}
                        <span class="spec-comment-mark" aria-hidden="true">
                          」
                        </span>
                      </p>
                    )}
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <!-- Footer note -->
    <p class="end-note">— 档案到此为止，新机入手时会自动续编 —</p>
  </div>
</ExploreShell>

<style>
  /* ===== layout ===== */
  .phones-page {
    padding: 1.25rem 1.5rem 3rem;
    max-width: 64rem;
  }

  /* ===== breadcrumb (same pattern as /my-goods) ===== */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    font-size: 13px;
    color: var(--explore-text-muted);
  }
  .bc-link {
    color: inherit;
    text-decoration: none;
  }
  .bc-link:hover {
    color: var(--explore-accent-strong);
  }
  .bc-sep {
    opacity: 0.5;
  }
  .bc-current {
    color: var(--explore-text);
  }

  /* ===== page header ===== */
  .page-header {
    margin-bottom: 1.5rem;
  }
  .page-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--explore-text-strong);
  }
  .title-icon {
    font-size: 24px;
  }
  .page-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--explore-text-muted);
    max-width: 50rem;
  }
  .page-desc strong {
    color: var(--explore-accent-strong);
    font-weight: 700;
  }
  .page-desc a {
    color: var(--explore-accent-strong);
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .page-desc a:hover {
    border-bottom-style: solid;
  }

  /* ===== stats card ===== */
  .stats-card {
    margin: 1.5rem 0 2rem;
    padding: 1.25rem 1.5rem;
    background: var(--explore-surface);
    border-radius: 16px;
    box-shadow: var(--explore-shadow);
    border: 1px solid var(--explore-border);
  }
  .stats-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .stat-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    border-right: 1px solid var(--explore-border);
  }
  .stat-cell:last-child {
    border-right: none;
  }
  .stat-num {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    line-height: 1;
    color: var(--explore-accent-strong);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .stat-num.accent-warm {
    color: var(--explore-warning);
  }
  .stat-lbl {
    font-size: 12px;
    font-weight: 500;
    color: var(--explore-text-meta);
  }

  .stats-divider {
    height: 1px;
    background: var(--explore-border);
    margin: 1rem 0 0.9rem;
  }

  .brand-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .brand-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--explore-accent-soft);
    font-size: 12px;
    font-weight: 600;
    color: var(--explore-text);
  }
  .brand-chip-num {
    color: var(--explore-accent-strong);
    font-weight: 700;
    font-size: 11px;
  }

  /* ===== catalog head ===== */
  .catalog-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
    flex-wrap: wrap;
  }
  .catalog-title {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
    color: var(--explore-text-strong);
  }
  .catalog-meta {
    font-size: 12.5px;
    color: var(--explore-text-meta);
  }

  /* ===== catalog / timeline ===== */
  .catalog {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .spec {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    opacity: 0;
    transform: translateY(8px);
    animation: spec-enter 600ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    animation-delay: var(--enter-delay, 0ms);
  }
  @keyframes spec-enter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* axis */
  .spec-axis {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.65rem;
  }
  .year-stamp {
    position: sticky;
    top: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .year-stamp-num {
    font-size: 18px;
    font-weight: 800;
    line-height: 1;
    color: var(--explore-text-strong);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    padding: 0.35rem 0.55rem;
    background: var(--explore-surface);
    border-radius: 999px;
    box-shadow: var(--explore-shadow);
    border: 1px solid var(--explore-border);
  }
  .year-stamp-cont {
    justify-content: center;
  }
  .year-stamp-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--explore-accent);
    box-shadow: 0 0 0 4px var(--explore-accent-soft);
  }
  .spec-thread {
    flex: 1;
    width: 2px;
    margin-top: 0.65rem;
    background: repeating-linear-gradient(
      to bottom,
      var(--explore-border) 0 4px,
      transparent 4px 8px
    );
    border-radius: 999px;
  }
  .spec:last-child .spec-thread {
    display: none;
  }

  /* spec card — matches /my-goods card style */
  .spec-card {
    background: var(--explore-surface);
    border-radius: 16px;
    box-shadow: var(--explore-shadow);
    border: 1px solid var(--explore-border);
    padding: 1rem 1.25rem 1.1rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .spec-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--explore-shadow-hover);
  }

  .spec-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px dashed var(--explore-border);
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .spec-no {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
    font-size: 12px;
    font-weight: 600;
    color: var(--explore-text-meta);
  }
  .spec-no-num {
    font-size: 15px;
    font-weight: 800;
    color: var(--explore-text);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .spec-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.4;
  }
  .spec-status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .spec-status-primary {
    background: var(--explore-accent-soft);
    color: var(--explore-accent-strong);
  }
  .spec-status-active {
    background: var(--explore-success-soft);
    color: var(--explore-success);
  }
  .spec-status-kept {
    background: var(--explore-warning-soft);
    color: var(--explore-warning);
  }
  .spec-status-retired {
    background: var(--explore-surface-muted);
    color: var(--explore-text-muted);
  }

  /* body */
  .spec-body {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  .spec-figure {
    margin: 0;
    padding: 0;
  }
  .spec-image {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: contain;
    object-position: center;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--explore-surface-muted) 0%, var(--explore-accent-soft) 100%);
    padding: 0.5rem;
    filter: drop-shadow(0 4px 12px color-mix(in srgb, var(--explore-text-strong) 8%, transparent));
  }

  .spec-info {
    min-width: 0;
  }
  .spec-brand {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--explore-accent-soft);
    color: var(--explore-accent-strong);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
  }
  .spec-name {
    margin: 0 0 0.75rem;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--explore-text-strong);
  }

  .spec-meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .spec-meta-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .spec-meta-lbl {
    flex: 0 0 32px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--explore-text-meta);
  }
  .spec-meta-val {
    font-weight: 500;
    color: var(--explore-text);
    font-variant-numeric: tabular-nums;
  }
  .spec-meta-pill {
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--explore-accent-soft);
    color: var(--explore-accent-strong);
    font-size: 11px;
    font-weight: 700;
  }
  .spec-meta-era {
    padding-left: 0.55rem;
    border-left: 1px solid var(--explore-border);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--explore-text-muted);
  }
  .spec-meta-hex {
    margin-left: auto;
    font-family:
      "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 11px;
    color: var(--explore-text-meta);
  }

  .spec-color-swatch {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--swatch);
    border: 1.5px solid var(--explore-border);
    box-shadow: inset 0 0 0 1.5px var(--explore-surface);
    flex-shrink: 0;
  }

  .spec-loved {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--explore-love);
    font-weight: 600;
  }
  .spec-loved svg {
    width: 13px;
    height: 13px;
  }

  /* ===== personal comment (one-line memory) ===== */
  .spec-comment {
    position: relative;
    margin: 0.85rem 0 0;
    padding: 0.65rem 0.85rem 0.65rem 0.95rem;
    border-left: 2px solid var(--explore-accent-border);
    background: var(--explore-accent-soft);
    border-radius: 0 10px 10px 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--explore-text);
    font-style: italic;
  }
  .spec-comment-mark {
    color: var(--explore-accent-strong);
    font-weight: 700;
    font-style: normal;
    margin: 0 0.05em;
  }

  /* end note */
  .end-note {
    text-align: center;
    margin: 2.5rem 0 0;
    font-size: 13px;
    color: var(--explore-text-meta);
  }

  /* ===== responsive ===== */
  @media (max-width: 900px) {
    .stats-row {
      grid-template-columns: repeat(5, 1fr);
      gap: 0.25rem;
    }
    .spec-body {
      grid-template-columns: 110px 1fr;
      gap: 0.85rem;
    }
    .spec-image {
      height: 130px;
    }
  }
  @media (max-width: 620px) {
    .phones-page {
      padding: 1rem 0.875rem 2.5rem;
    }
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
    .stat-cell:nth-child(3) {
      border-right: none;
    }
    .stat-cell:nth-child(n + 4) {
      border-top: 1px solid var(--explore-border);
      padding-top: 0.65rem;
      margin-top: 0.5rem;
    }
    .spec {
      grid-template-columns: 52px 1fr;
      gap: 0.6rem;
    }
    .year-stamp-num {
      font-size: 14px;
      padding: 0.3rem 0.45rem;
    }
    .spec-card {
      padding: 0.85rem 0.95rem 1rem;
    }
    .spec-body {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
    .spec-image {
      height: 180px;
    }
    .spec-meta-hex {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spec {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .spec-card {
      transition: none;
    }
  }
</style>
