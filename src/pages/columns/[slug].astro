---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import { mdxComponents } from '../../components/mdx-components';
import * as styles from '../../layouts/BlogPost.css';
import * as columnStyles from '../../styles/columnPage.css';
import * as chapterStyles from '../../styles/columnChapters.css';
import { buildColumnBuckets, postHref, sortBlogPosts, type ColumnBucket } from '../../utils/content';

export async function getStaticPaths() {
	const posts = sortBlogPosts(await getCollection('posts'));
	const columns = await getCollection('columns');

	return buildColumnBuckets(posts, columns)
		.filter((bucket) => bucket.entry)
		.map((bucket) => ({
			params: { slug: bucket.slug },
			props: { bucket, column: bucket.entry },
		}));
}

interface Props {
	bucket: ColumnBucket;
	column: CollectionEntry<'columns'>;
}

const { bucket, column } = Astro.props as Props;
const { Content, headings } = await render(column);
const firstPost = bucket.posts[0];
// 已有导读正文时不在标题下重复摘要；只有空入口才展示 frontmatter 简介。
const showDescription = !column.body?.trim() && Boolean(bucket.description);
const formatDate = (date: Date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
---

<StellarShell
	title={`${bucket.title} · 专栏 · ${SITE_TITLE}`}
	description={column.data.description || SITE_DESCRIPTION}
	mainClass={columnStyles.main}
	siteTree="column"
	tocHeadings={headings}
	column={{
		title: bucket.title,
		description: bucket.description,
		icon: column.data.icon,
		count: bucket.posts.length,
		posts: bucket.posts,
	}}
>
	<article class={columnStyles.article} aria-labelledby="column-title">
		<header class={columnStyles.header} data-column-header>
			<nav class={columnStyles.breadcrumbs} aria-label="面包屑导航">
				<ol class={columnStyles.breadcrumbList}>
					<li><a class={columnStyles.breadcrumbLink} href="/">首页</a></li>
					<li class={columnStyles.breadcrumbSeparator} aria-hidden="true">/</li>
					<li><a class={columnStyles.breadcrumbLink} href="/columns">专栏</a></li>
				</ol>
			</nav>
			<h1 class={columnStyles.title} id="column-title">{bucket.title}</h1>
			{showDescription && <p class={columnStyles.description}>{bucket.description}</p>}
			<div class={columnStyles.headerBottom}>
				<p class={columnStyles.chapterCount}>共 <span class={columnStyles.countNumber}>{bucket.posts.length}</span> 篇文章</p>
				<div class={columnStyles.actions}>
					<a class={columnStyles.directoryLink} href="#column-chapters" data-column-directory>
						浏览目录
						<svg class={columnStyles.actionIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" /></svg>
					</a>
					{firstPost && (
						<a class={columnStyles.readLink} href={postHref(firstPost)} title={firstPost.data.title} aria-label={`开始阅读${bucket.title}：${firstPost.data.title}`} data-column-start>
							开始阅读
							<svg class={columnStyles.actionIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
						</a>
					)}
				</div>
			</div>
		</header>
		<div class:list={[styles.prose, 'md-text', 'content']}>
			<Content components={mdxComponents} />

			{/* 章节目录放在正文里，而不是只藏在侧栏：
			    手机端侧栏是折叠的，只有正文里的目录才能保证「按顺序读」这条主线始终可达。 */}
			<section class={chapterStyles.chapterSection} aria-labelledby="column-chapters">
				<h2 class={chapterStyles.chapterSectionTitle} id="column-chapters">
					章节目录
					<span class={chapterStyles.chapterSectionCount}>共 {bucket.posts.length} 章</span>
				</h2>
				<ol class={chapterStyles.chapterList}>
					{
						bucket.posts.map((post, index) => (
							<li class={chapterStyles.chapterItem}>
								<a class={chapterStyles.chapterLink} href={postHref(post)}>
									<span class={chapterStyles.chapterIndex}>{String(index + 1).padStart(2, '0')}</span>
									<span class={chapterStyles.chapterTitle}>{post.data.title}</span>
									<span class={chapterStyles.chapterDate}>{formatDate(post.data.pubDate)}</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>
		</div>
	</article>
</StellarShell>
