---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArtalkComments from '../components/ArtalkComments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import KatexStyles from '../components/KatexStyles.astro';
import type { SiteTreeKey } from '../config/stellar';
import { SITE_AUTHOR } from '../consts';
import StellarShell from './StellarShell.astro';
import * as styles from './BlogPost.css';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	banner?: ImageMetadata | string;
	image?: ImageMetadata | string;
	siteTree?: SiteTreeKey;
	headings?: { depth: number; slug: string; text: string }[];
	mathjax?: boolean;
}

const { title, description, pubDate, updatedDate, banner, image, siteTree = 'post', headings = [], mathjax = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 文章 OG / JSON-LD 共用的图片 URL：优先 banner，回退 cover（由路由通过 resolvePostCover 解析后传入）
const articleImageUrl = image
	? new URL(typeof image === 'string' ? image : image.src, Astro.site).toString()
	: undefined;
const blogPostingJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(articleImageUrl ? { image: articleImageUrl } : {}),
};
const blogPostingJsonLdSafe = JSON.stringify(blogPostingJsonLd).replace(/</g, '\\u003c');
---

<StellarShell title={title} description={description} mainClass={styles.main} siteTree={siteTree} tocHeadings={headings} type="article" image={image} publishedTime={pubDate} modifiedTime={updatedDate}>
	{mathjax && <KatexStyles />}
	<script is:inline type="application/ld+json" set:html={blogPostingJsonLdSafe} />
	<article class={styles.article}>
		<header class:list={[styles.banner, 'article', 'banner', 'top']}>
			{banner && (
				typeof banner === 'string' ? (
					<img class:list={[styles.bannerImage, 'bg']} src={banner} alt="" />
				) : (
					<Image class:list={[styles.bannerImage, 'bg']} width={1020} height={408} src={banner} alt="" />
				)
			)}
			<div class:list={[styles.bannerContent, banner && styles.bannerContentWithImage, 'content']}>
				<div class:list={[styles.bannerMeta, 'top', 'bread-nav', 'footnote']}>
					<div class="left">
						<div class="flex-row" id="breadcrumb">
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/">Home</a>
							<span class="sep">/</span>
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/posts">Blog</a>
						</div>
						<div id="post-meta">
							<span>发布于：<FormattedDate date={pubDate} /></span>
							{updatedDate && <><span class="sep"></span><span class="updated">更新于：<FormattedDate date={updatedDate} /></span></>}
						</div>
					</div>
				</div>
				<div class:list={[styles.bannerBottom, 'bottom', 'only-title']}>
					<div class="text-area">
						<h1 class:list={[styles.title, 'text', 'title']}><span>{title}</span></h1>
					</div>
				</div>
			</div>
		</header>
		<div class:list={[styles.prose, 'md-text', 'content']}>
			<slot />
		</div>
		<ArtalkComments pageKey={canonicalURL.pathname} pageTitle={title} />
	</article>
</StellarShell>
