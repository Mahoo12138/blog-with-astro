---
/**
 * Diagram —— 遵循 diagram.css.ts「Diagram Standard v1」的声明式示意图。
 *
 * 作者只声明「节点 + 箭头 + 注记」，不写任何箭头坐标：
 *   - 节点：x/y/w/h，或 span:[startByte,endByte]（配合 pxPerByte/x0 自动算宽）
 *   - 箭头：from + at/to/len（端点由节点几何计算，天然对齐）
 *   - 注记：at:'canvas' 居中 / 绝对 x
 * 全部落在同一 SVG viewBox 坐标系，缩放与主题由样式层统一。
 */
import * as s from './diagram.css';

type Role = 'instr' | 'gap' | 'target' | 'formula' | 'neutral';

interface DNode {
	id: string;
	x?: number;
	y: number;
	w?: number;
	h: number;
	/** 字节跨度（需同时给 pxPerByte），盒宽与边界随之成正比 */
	span?: [number, number];
	role?: Role;
	title: string;
	sub?: string;
}

interface DArrow {
	from: string;
	/** 垂直箭头在源节点底边的锚点，默认 center */
	at?: 'left' | 'center' | 'right';
	/** 源节点底边锚点的绝对 x（覆盖 at，用于竖向对齐某个目标） */
	fromX?: number;
	to?: string;
	/** 目标顶边锚点的绝对 x（默认目标中心） */
	toX?: number;
	/** 无 to 时向下画 len 长的短箭头 */
	len?: number;
	/** right = 从源右缘指向目标左缘（横向连接） */
	dir?: 'down' | 'right';
	label?: string;
	labelAlign?: 'start' | 'middle' | 'end';
}

interface DNote {
	at?: 'canvas';
	x?: number;
	y: number;
	w?: number;
	h?: number;
	align?: 'start' | 'center' | 'end';
	text: string;
}

interface Props {
	label: string;
	width: number;
	height: number;
	/** 字节布局比例：每个字节对应的画布单位 */
	pxPerByte?: number;
	/** 字节 0 所在的 x 坐标 */
	x0?: number;
	nodes: DNode[];
	arrows?: DArrow[];
	notes?: DNote[];
}

const { label, width, height, pxPerByte, x0 = 0, nodes, arrows = [], notes = [] } = Astro.props;

type Box = { x: number; y: number; w: number; h: number };
const geo = new Map<string, Box>();
for (const n of nodes) {
	const x = n.span && pxPerByte ? x0 + n.span[0] * pxPerByte : (n.x ?? 0);
	const w = n.span && pxPerByte ? (n.span[1] - n.span[0]) * pxPerByte : (n.w ?? 0);
	geo.set(n.id, { x, y: n.y, w, h: n.h });
}

const resolved = arrows
	.map((a) => {
		const from = geo.get(a.from);
		if (!from) return null;
		const to = a.to ? geo.get(a.to) : undefined;

		if (a.dir === 'right') {
			const ax = from.x + from.w;
			const ay = from.y + from.h / 2;
			const bx = to ? to.x : ax + (a.len ?? 16);
			const by = to ? to.y + to.h / 2 : ay;
			return { ax, ay, bx, by, label: a.label, align: a.labelAlign ?? 'middle', hasTo: Boolean(to) };
		}

		const ax = a.fromX ?? (a.at === 'left' ? from.x : a.at === 'right' ? from.x + from.w : from.x + from.w / 2);
		const ay = from.y + from.h;
		const bx = to ? (a.toX ?? to.x + to.w / 2) : ax;
		const by = to ? to.y : ay + (a.len ?? 16);
		return { ax, ay, bx, by, label: a.label, align: a.labelAlign ?? 'middle', hasTo: Boolean(to) };
	})
	.filter((a): a is NonNullable<typeof a> => a !== null);

const resolvedNotes = notes.map((nt) => {
	const w = nt.w ?? width;
	const h = nt.h ?? 20;
	const x =
		nt.at === 'canvas'
			? nt.align === 'end'
				? width - w
				: nt.align === 'start'
					? 0
					: (width - w) / 2
			: (nt.x ?? 0);
	return { x, y: nt.y, w, h, align: nt.align ?? 'center', text: nt.text };
});

let hash = 0;
for (const ch of `${label}|${width}|${height}`) hash = (hash * 31 + ch.charCodeAt(0)) | 0;
const headId = `dg-head-${Math.abs(hash).toString(36)}`;
---

<div class={s.scroll}>
	<svg
		class={s.svg}
		style={`max-width:${Math.round(width * 1.3)}px;min-width:${Math.round(width * 0.88)}px;`}
		viewBox={`0 0 ${width} ${height}`}
		role="img"
		aria-label={label}
	>
		<defs>
			<marker id={headId} markerWidth="7" markerHeight="7" refX="5" refY="3" orient="auto">
				<path class={s.arrowHead} d="M0,0 L6,3 L0,6Z" />
			</marker>
		</defs>

		{
			resolved.map((a) => (
				<>
					<line class={s.arrowLine} x1={a.ax} y1={a.ay} x2={a.bx} y2={a.by} marker-end={`url(#${headId})`} />
					{a.label && !a.hasTo && (
						<text class={s.arrowLabel} x={a.ax} y={a.by + 13} text-anchor={a.align}>
							{a.label}
						</text>
					)}
				</>
			))
		}

		{
			nodes.map((n) => {
				const g = geo.get(n.id)!;
				return (
					<foreignObject x={g.x} y={g.y} width={g.w} height={g.h}>
						<div class={s.node} data-role={n.role ?? 'neutral'}>
							<b class={s.title}>{n.title}</b>
							{n.sub && <span class={s.sub}>{n.sub}</span>}
						</div>
					</foreignObject>
				);
			})
		}

		{
			resolvedNotes.map((nt) => (
				<foreignObject x={nt.x} y={nt.y} width={nt.w} height={nt.h}>
					<div class={s.note} style={`text-align:${nt.align};`}>
						{nt.text}
					</div>
				</foreignObject>
			))
		}
	</svg>
</div>
