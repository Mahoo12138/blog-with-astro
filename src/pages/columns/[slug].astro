---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import { mdxComponents } from '../../components/mdx-components';
import * as styles from '../../layouts/BlogPost.css';
import * as columnStyles from '../../styles/columnPage.css';
import * as chapterStyles from '../../styles/columnChapters.css';
import { buildColumnBuckets, postHref, sortBlogPosts, type ColumnBucket } from '../../utils/content';

export async function getStaticPaths() {
	const posts = sortBlogPosts(await getCollection('posts'));
	const columns = await getCollection('columns');

	return buildColumnBuckets(posts, columns)
		.filter((bucket) => bucket.entry)
		.map((bucket) => ({
			params: { slug: bucket.slug },
			props: { bucket, column: bucket.entry },
		}));
}

interface Props {
	bucket: ColumnBucket;
	column: CollectionEntry<'columns'>;
}

const { bucket, column } = Astro.props as Props;
const { Content, headings } = await render(column);
const initial = bucket.title.slice(0, 1);
const formatDate = (date: Date) =>
	`${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
---

<StellarShell
	title={`${bucket.title} · 专栏 · ${SITE_TITLE}`}
	description={column.data.description || SITE_DESCRIPTION}
	mainClass={columnStyles.main}
	siteTree="column"
	tocHeadings={headings}
	column={{
		title: bucket.title,
		description: bucket.description,
		icon: column.data.icon,
		count: bucket.posts.length,
		posts: bucket.posts,
	}}
>
	<article class={columnStyles.article}>
		{/* 专栏头图：仅保留 cover 兜底（banner 字段已随 Schema 收敛删除，实测 0 篇使用） */}
		<header class:list={[styles.banner, columnStyles.noBanner, 'article', 'banner', 'top']}>
			<div class={columnStyles.bannerFallback} aria-hidden="true">
				<span class={columnStyles.bannerFallbackInitial}>{initial}</span>
			</div>
			<div class:list={[styles.bannerContent, 'content']}>
				<div class:list={[styles.bannerMeta, 'top', 'bread-nav', 'footnote']}>
					<div class="left">
						<div class="flex-row" id="breadcrumb">
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/">Home</a>
							<span class="sep">/</span>
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/columns">专栏</a>
							<span class="sep">/</span>
							<span class:list={[styles.breadcrumb, 'cap', 'breadcrumb']}>{bucket.title}</span>
						</div>
					</div>
				</div>
				<div class:list={[styles.bannerBottom, 'bottom', 'only-title']}>
					<div class="text-area">
						<h1 class:list={[styles.title, 'text', 'title']}><span>{bucket.title}</span></h1>
					</div>
				</div>
			</div>
		</header>
		<div class:list={[styles.prose, 'md-text', 'content']}>
			<Content components={mdxComponents} />

			{/* 章节目录放在正文里，而不是只藏在侧栏：
			    手机端侧栏是折叠的，只有正文里的目录才能保证「按顺序读」这条主线始终可达。 */}
			<section class={chapterStyles.chapterSection} aria-labelledby="column-chapters">
				<h2 class={chapterStyles.chapterSectionTitle} id="column-chapters">
					章节目录
					<span class={chapterStyles.chapterSectionCount}>共 {bucket.posts.length} 章</span>
				</h2>
				<ol class={chapterStyles.chapterList}>
					{
						bucket.posts.map((post, index) => (
							<li class={chapterStyles.chapterItem}>
								<a class={chapterStyles.chapterLink} href={postHref(post)}>
									<span class={chapterStyles.chapterIndex}>{String(index + 1).padStart(2, '0')}</span>
									<span class={chapterStyles.chapterTitle}>{post.data.title}</span>
									<span class={chapterStyles.chapterDate}>{formatDate(post.data.pubDate)}</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>
		</div>
	</article>
</StellarShell>
