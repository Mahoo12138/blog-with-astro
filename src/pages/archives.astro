---
import { getCollection } from 'astro:content';
import StellarNavTabs from '../components/StellarNavTabs.astro';
import { SITE_DESCRIPTION, SITE_TITLE, columnUrl } from '../consts';
import StellarShell from '../layouts/StellarShell.astro';
import * as styles from '../styles/homeFeed.css';
import { buildColumnBuckets, postHref, sortBlogPosts, standalonePosts } from '../utils/content';

/**
 * 归档页采用两段式：
 *   上半段 —— 博客文章按年逐篇（用于「我记得某年写过一篇讲 X 的」这种定位）
 *   下半段 —— 专栏按系列聚合，每个系列只占一条
 *
 * 专栏章节刻意不逐篇进年表：章节的价值在顺序而不在日期，
 * 混进来只会让某一年被同一个学习系列占满（数据结构与算法 9 篇 + STM32 8 篇都在 2019）。
 */
const published = sortBlogPosts(await getCollection('posts'));
const posts = standalonePosts(published);
const columns = buildColumnBuckets(published, await getCollection('columns'));

const archives = posts.reduce<Map<number, typeof posts>>((map, post) => {
	const year = post.data.pubDate.getFullYear();
	const bucket = map.get(year) ?? [];
	bucket.push(post);
	map.set(year, bucket);
	return map;
}, new Map());

const groups = Array.from(archives.entries()).sort((a, b) => b[0] - a[0]);
const formatArchiveDate = (date: Date) => `${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
const formatMonth = (date: Date) => `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}`;

/** 时间跨度：单月只显示一次，跨月显示区间 —— 让读者一眼看出系列是「还在更新」还是「已完结」 */
function formatSpan(startedAt?: Date, updatedAt?: Date) {
	if (!startedAt || !updatedAt) {
		return '';
	}
	const start = formatMonth(startedAt);
	const end = formatMonth(updatedAt);
	return start === end ? start : `${start} – ${end}`;
}
---

<StellarShell title={`Archives · ${SITE_TITLE}`} description={SITE_DESCRIPTION} mainClass={styles.archiveMain} siteTree="archives">
	<header class={styles.header}>
		{/* 年份用 h2 作分节标题，但文档还需要一个 h1 作为大纲根节点，
		    否则 h2 直接浮在顶层（axe: page-has-heading-one）。 */}
		<h1 class="sr-only">归档</h1>
		<StellarNavTabs active="archives" />
	</header>
	<div class={styles.archivePostList}>
		{
			groups.map(([year, yearPosts]) => (
				<article class={styles.archiveSection} id="archive">
					<h2 class={styles.archiveYear}>{year}</h2>
					<ul class={styles.archiveList}>
						{
							yearPosts.map((post) => (
								<li class={styles.archiveItem}>
									<a class={styles.archiveLink} href={postHref(post)}>
										<time class={styles.archiveDate} datetime={post.data.pubDate.toISOString()}>
											{formatArchiveDate(post.data.pubDate)}
										</time>
										<span class={styles.archiveTitle}>{post.data.title}</span>
									</a>
								</li>
							))
						}
					</ul>
				</article>
			))
		}
	</div>

	{
		columns.length > 0 && (
			<section class={styles.archiveColumnSection} aria-labelledby="archive-columns">
				<h2 class={styles.archiveColumnHeading} id="archive-columns">
					<span class={styles.archiveYear}>专栏</span>
					<span class={styles.archiveColumnNote}>
						按系列聚合，共 {columns.length} 个系列、{columns.reduce((sum, column) => sum + column.count, 0)} 章
					</span>
				</h2>
				<ul class={styles.archiveColumnList}>
					{columns.map((column) => (
						<li class={styles.archiveColumnItem}>
							<a class={styles.archiveColumnLink} href={columnUrl(column.slug)}>
								<span class={styles.archiveColumnTitle}>{column.title}</span>
								<span class={styles.archiveColumnMeta}>
									{column.count} 章 · {formatSpan(column.startedAt, column.updatedAt)}
								</span>
								{column.description && <p class={styles.archiveColumnDesc}>{column.description}</p>}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</StellarShell>
