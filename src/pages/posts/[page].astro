---
import BlogFeedList from '../../components/BlogFeedList.astro';
import Pagination from '../../components/Pagination.astro';
import StellarNavTabs from '../../components/StellarNavTabs.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import * as styles from '../../styles/homeFeed.css';
import { buildBlogFeed, loadBlogFeedSource, type BlogFeedItem } from '../../utils/content';

export async function getStaticPaths() {
	// 与首页、/posts/ 共用同一个博客流，分页边界才不会错位
	const { posts, columns } = await loadBlogFeedSource();
	const feed = buildBlogFeed(posts, columns);
	const totalPages = Math.max(1, Math.ceil(feed.length / POSTS_PER_PAGE));

	const paths = [];
	for (let page = 2; page <= totalPages; page += 1) {
		const start = (page - 1) * POSTS_PER_PAGE;
		paths.push({
			params: { page: String(page) },
			props: {
				page,
				totalPages,
				items: feed.slice(start, start + POSTS_PER_PAGE),
			},
		});
	}
	return paths;
}

interface Props {
	page: number;
	totalPages: number;
	items: BlogFeedItem[];
}

const { page, totalPages, items } = Astro.props as Props;
const prevUrl = page === 2 ? '/posts/' : `/posts/${page - 1}`;
const nextUrl = page < totalPages ? `/posts/${page + 1}` : undefined;
---

<StellarShell title={`第 ${page} 页 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} mainClass={styles.main} siteTree="home">
	<header class={styles.header}>
		{/* 同 /posts/：分页页也需要 h1 作为大纲根节点（见 posts/index.astro 注释） */}
		<h1 class="sr-only">全部文章 · 第 {page} 页</h1>
		<StellarNavTabs active="home" />
	</header>
	<BlogFeedList items={items} />
	<Pagination currentPage={page} totalPages={totalPages} prevUrl={prevUrl} nextUrl={nextUrl} />
</StellarShell>
