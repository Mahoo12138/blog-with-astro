---
/**
 * 卡片渲染调度器 — 按 item.type 选择对应卡片组件
 *
 * 新增卡片类型只需两步：
 *   1. 在 src/config/welcomeGrid.ts 扩展 WelcomeCardType 联合
 *   2. 在本文件 registry 中追加 (type, Component) 映射
 *
 * 响应式策略：grid 容器在 CSS 层处理断点（8 列 → 4 列），
 * 子组件只需考虑两种 span（宽屏 span / 窄屏 narrow），不需要关心具体断点宽度。
 *
 * React 集成：countdown 卡片为 React island（chinese-days 客户端计算）
 *  - SSR 渲染骨架，client:visible 触发 hydrate
 *  - 其他卡片保持 Astro 组件
 */
import type { AnyCardItem } from '../../config/welcomeGrid';
import NavigationCard from './NavigationCard.astro';
import ContactCard from './ContactCard.astro';
import PoetryCard from './PoetryCard.astro';
import SidebarCard from './SidebarCard.astro';
import CountdownCardIsland from './CountdownCardIsland.astro';

interface Props {
	item: AnyCardItem;
}

const { item } = Astro.props as Props;
---

<Fragment>
	{item.type === 'navigation' && (
		<NavigationCard props={(item as any).props} span={item.span} title={item.title} />
	)}
	{item.type === 'contact' && (
		<ContactCard props={(item as any).props} span={item.span} title={item.title} />
	)}
	{item.type === 'poetry' && (
		<PoetryCard props={(item as any).props} title={item.title} />
	)}
	{item.type === 'countdown' && <CountdownCardIsland />}
	{item.type === 'sidebar' && (
		<SidebarCard props={(item as any).props} title={item.title} />
	)}
</Fragment>
