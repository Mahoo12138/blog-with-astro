---
import BaseHead from '../components/BaseHead.astro';
import * as styles from './BlankShell.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
	noindex?: boolean;
}

const { title, description, lang = 'zh-CN', noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} noindex={noindex} />
	</head>
	<body class={styles.body}>
		<main class={styles.main} data-pagefind-ignore>
			<slot />
		</main>
	</body>
</html>
