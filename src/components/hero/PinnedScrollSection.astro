---
import HeroSection from './HeroSection.astro';
import WelcomeCards from './WelcomeCards.astro';
import * as styles from '../../styles/pinnedScroll.css';
---

<section class={styles.pinContainer} data-pinned-container>
	<div class={styles.stage} data-pinned-stage>
		<div class={styles.layer} data-pinned-layer="hero">
			<HeroSection />
		</div>
		<div class={styles.layer} data-pinned-layer="welcome">
			<WelcomeCards />
		</div>
	</div>
	<div class={styles.progressHint} data-pinned-progress aria-hidden="true">
		<span data-pinned-progress-label>滚动浏览</span>
		<span data-pinned-progress-value>0%</span>
	</div>
</section>

<script is:inline>
	(() => {
		// 事件委托：避免 init() 多次执行时重复绑定 handler，也避免旧 DOM 引用过期
		// 用 window 上的标记跨 ClientRouter 页面切换持久化
		if (!window.__pinnedScrollExploreBound) {
			document.addEventListener('click', (event) => {
				const target = event.target;
				const btn = target && target.closest ? target.closest('[data-scroll-to-welcome]') : null;
				if (!btn) return;

				// 目标：钉屏容器底部 = 文章列表顶部
				// 每次点击实时查询，避免闭包内引用过期
				const container = document.querySelector('[data-pinned-container]');
				if (!container) return;
				const targetY = container.getBoundingClientRect().bottom + window.scrollY;
				const startY = window.scrollY;
				const distance = targetY - startY;
				if (distance <= 0) return;

				// 关键：暂停钉屏动画（lerp RAF + scroll 监听）
				// 避免和点击滚动互相干扰（双重动画导致视觉卡顿）
				if (window.__pinnedScrollCleanup) {
					window.__pinnedScrollCleanup();
				}

				// 自定义滚动动画：固定 450ms 时长 + easeInOutCubic
				// 比浏览器 behavior: 'smooth' 的 ease-out 末期减速更轻，后半段不拖
				const duration = 450;
				const startTime = performance.now();
				const easeInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

				const step = (now) => {
					const elapsed = now - startTime;
					const p = Math.min(1, elapsed / duration);
					const eased = easeInOutCubic(p);
					window.scrollTo(0, startY + distance * eased);
					if (p < 1) {
						requestAnimationFrame(step);
					} else {
						// 滚动到位后重新初始化钉屏
						// 此时 scrollY === targetY，targetProgress = 1，welcome 完全显示
						init();
					}
				};
				requestAnimationFrame(step);
			});
			window.__pinnedScrollExploreBound = true;
		}

		const init = () => {
			const container = document.querySelector('[data-pinned-container]');
			const heroLayer = document.querySelector('[data-pinned-layer="hero"]');
			const welcomeLayer = document.querySelector('[data-pinned-layer="welcome"]');
			if (!container || !heroLayer || !welcomeLayer) return;

			// 清理上一次 init 留下的 RAF 和监听（避免 ClientRouter 跨页面切换时叠加）
			if (window.__pinnedScrollCleanup) {
				window.__pinnedScrollCleanup();
			}

			const heroSection = heroLayer.querySelector('[data-hero-section]');
			const welcomeSection = welcomeLayer.querySelector('[data-welcome-cards]');

			// 缓动函数
			const clamp = (v, min, max) => Math.max(min, Math.min(max, v));
			const smoothstep = (edge0, edge1, x) => {
				const t = clamp((x - edge0) / (edge1 - edge0), 0, 1);
				return t * t * (3 - 2 * t);
			};

			// ── 关键优化：把"目标进度"和"显示进度"分离 ──
			// targetProgress 由 scroll 事件即时更新（跟手）
			// currentProgress 由 RAF 循环通过 lerp 慢慢追上 targetProgress（平滑）
			// 这样滚动的小抖动会被 currentProgress 的"阻尼"吸收掉，视觉上不再卡顿
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			let targetProgress = 0;
			let currentProgress = 0;
			const SMOOTHING = 0.18; // 越大越跟手、越小越平滑
			let rafId = null;

			const apply = () => {
				// hero：快速淡出（0~0.4 完成）
				const heroT = smoothstep(0, 0.4, currentProgress);
				const heroOpacity = 1 - heroT;
				heroLayer.style.opacity = String(heroOpacity.toFixed(3));
				heroLayer.style.transform = `scale(${(0.96 + 0.04 * heroOpacity).toFixed(3)})`;
				if (heroSection) {
					heroSection.style.pointerEvents = heroOpacity < 0.05 ? 'none' : '';
				}

				// welcome：稍后淡入（0.15~0.5 完成），之后保持稳定
				const welcomeT = smoothstep(0.15, 0.5, currentProgress);
				welcomeLayer.style.opacity = String(welcomeT.toFixed(3));
				welcomeLayer.style.transform = `translateY(${((1 - welcomeT) * 24).toFixed(2)}px)`;
				welcomeLayer.style.pointerEvents = welcomeT > 0.6 ? 'auto' : 'none';

				// 触发卡片入场动画
				if (welcomeSection && welcomeT > 0.5) {
					welcomeSection.setAttribute('data-visible', 'true');
				}

				// 进度提示（基于 targetProgress，反映用户真实意图）
				const hint = document.querySelector('[data-pinned-progress]');
				const value = document.querySelector('[data-pinned-progress-value]');
				if (hint) {
					if (targetProgress > 0 && targetProgress < 1) {
						hint.setAttribute('data-active', 'true');
						if (value) value.textContent = `${Math.round(targetProgress * 100)}%`;
					} else {
						hint.removeAttribute('data-active');
					}
				}
			};

			// 事件驱动 RAF：仅当 targetProgress 与 currentProgress 不一致时启动，
			// 到达目标后停止；用户停止滚动时不再有永久 60fps 循环。
			const tick = () => {
				const diff = targetProgress - currentProgress;
				if (Math.abs(diff) > 0.0005) {
					currentProgress += diff * SMOOTHING;
					apply();
					rafId = requestAnimationFrame(tick);
				} else if (currentProgress !== targetProgress) {
					// 极接近时直接 snap 到目标，避免无限微小 RAF
					currentProgress = targetProgress;
					apply();
					rafId = null;
				} else {
					rafId = null;
				}
			};

			const startRaf = () => {
				if (rafId !== null || prefersReducedMotion) return;
				rafId = requestAnimationFrame(tick);
			};

			// scroll/resize 只更新 targetProgress，不直接动 DOM
			const onScroll = () => {
				const rect = container.getBoundingClientRect();
				const viewport = window.innerHeight || document.documentElement.clientHeight;
				const pinDistance = container.offsetHeight - viewport;
				const scrolled = clamp(-rect.top, 0, pinDistance);
				targetProgress = pinDistance > 0 ? scrolled / pinDistance : 0;
				if (prefersReducedMotion) {
					// reduced-motion：跳过缓动，直接 snap 到目标
					currentProgress = targetProgress;
					apply();
				} else if (targetProgress !== currentProgress) {
					startRaf();
				}
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			window.addEventListener('resize', onScroll, { passive: true });

			// 立即同步初始状态（顶部 / 任意 scrollY）：首屏直接 snap，不做入场动画
			onScroll();
			currentProgress = targetProgress;
			apply();

			// 暴露 cleanup，下一次 init 进来时调用
			window.__pinnedScrollCleanup = () => {
				if (rafId !== null) cancelAnimationFrame(rafId);
				rafId = null;
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onScroll);
			};
		};

		// 首次加载 + ClientRouter 页面切换（包括同页跳转）后都重新初始化滚动驱动逻辑
		init();
		document.addEventListener('astro:page-load', init);
	})();
</script>
