---
import type { WidgetProps } from './types';
import * as leftStyles from '../StellarLeftSidebar.css';
import * as rightStyles from '../StellarRightSidebar.css';
import * as columnStyles from './column.css';

const { widget, side, context } = Astro.props as WidgetProps;
const column = context.column;
const s = side === 'left' ? leftStyles : rightStyles;
const headerClass = side === 'left' ? leftStyles.widgetTitle : rightStyles.widgetHeader;
---

{column && (
	<section class:list={[s.widget, columnStyles.infoWidget]}>
		<div class={headerClass}><span>{widget.title}</span></div>
		<div class={columnStyles.infoCard}>
			<div class={columnStyles.infoHead}>
				{column.icon ? (
					<img class={columnStyles.infoIcon} src={column.icon} alt="" />
				) : (
					<span class={columnStyles.infoFallback}>{column.title.slice(0, 1)}</span>
				)}
				<div class={columnStyles.infoMeta}>
					<h2 class={columnStyles.infoTitle}>{column.title}</h2>
					<span class={columnStyles.infoCount}>{column.count} 篇文章</span>
				</div>
			</div>
			{column.description && <p class={columnStyles.infoDescription}>{column.description}</p>}
		</div>
	</section>
)}
