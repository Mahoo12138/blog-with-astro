---
import { stellarConfig } from '../config/stellar';
import { SITE_TITLE } from '../consts';
import * as styles from './StellarPageFooter.css';

const sitemap = stellarConfig.footer.sitemap;
const content = stellarConfig.footer.content
	.replace('{year}', String(new Date().getFullYear()))
	.replace('{site.title}', SITE_TITLE);
---

<footer class:list={[styles.root, 'page-footer', 'footnote']} aria-label="站点页脚" data-pagefind-ignore>
	{
		sitemap.length > 0 && (
			<nav class={styles.sitemap} aria-label="页脚导航">
				{sitemap.map((group) => (
					<div class={styles.sitemapGroup}>
						<h2 class={styles.groupTitle}>{group.title}</h2>
						<ul class={styles.links} role="list">
							{group.items.map((item) => (
								<li class={styles.item}><a class={styles.link} href={item.url}>{item.label}</a></li>
							))}
						</ul>
					</div>
				))}
			</nav>
		)
	}
	<p class={styles.text}>{content}</p>
</footer>