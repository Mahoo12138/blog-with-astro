---
import { getCollection } from 'astro:content';
import Pagination from '../../components/Pagination.astro';
import StellarNavTabs from '../../components/StellarNavTabs.astro';
import StellarPostCard from '../../components/StellarPostCard.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import * as styles from '../../styles/taxonomy.css';
import { buildTaxonomyBuckets, sortBlogPosts, type TaxonomyBucket } from '../../utils/content';

export async function getStaticPaths() {
	const posts = sortBlogPosts(await getCollection('posts'));
	return buildTaxonomyBuckets(posts, 'tags').map((bucket) => ({
		params: { slug: bucket.slug },
		props: { bucket },
	}));
}

interface Props {
	bucket: TaxonomyBucket;
}

const { bucket } = Astro.props as Props;
const totalPages = Math.max(1, Math.ceil(bucket.posts.length / POSTS_PER_PAGE));
const posts = bucket.posts.slice(0, POSTS_PER_PAGE);
const nextUrl = totalPages > 1 ? `/tags/${bucket.slug}/2` : undefined;
---

<StellarShell title={`${bucket.label} · Tags · ${SITE_TITLE}`} description={SITE_DESCRIPTION} mainClass={styles.pageMain} siteTree="index_blog">
	<header class={styles.header}>
		<StellarNavTabs active="tags" />
	</header>
	<h1 class={styles.srOnly}>{bucket.label}</h1>
	<div class={styles.postList}>
		<ul class={styles.list}>
			{
				posts.map((post) => (
					<li class={styles.item}>
						<StellarPostCard post={post} />
					</li>
				))
			}
		</ul>
	</div>
	<Pagination currentPage={1} totalPages={totalPages} nextUrl={nextUrl} />
</StellarShell>
