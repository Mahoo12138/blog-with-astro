---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { mdxComponents } from '../../components/mdx-components';
import BlogPost from '../../layouts/BlogPost.astro';
import { resolvePostCover } from '../../utils/content';

// 过滤 draft：草稿不生成静态页面，避免通过直链访问 / 被 sitemap 收录
export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'posts'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const banner = post.data.banner;
const cover = resolvePostCover(post);
// 统一图片模型：banner = 文章头图；cover（或 Hexo img）= 列表缩略图 / 默认分享图。
// 文章页 OG / JSON-LD 优先用 banner，回退到 cover。
const articleImage = banner ?? cover?.src;
---

<BlogPost title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} banner={banner} image={articleImage} headings={headings} mathjax={post.data.mathjax}>
	<Content components={mdxComponents} />
</BlogPost>
