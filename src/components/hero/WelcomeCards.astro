---

<section class={styles.section} data-welcome-cards>
	<div class={styles.container}>
		<div class={styles.left}>
			<h2 class={styles.greeting}>
				Hi, 朋友 <span class={styles.wave} aria-hidden="true">👋</span>
			</h2>
			<p class={styles.headline}>欢迎访问我的空间！</p>
			<p class={styles.subline}>更多信息可关注语雀花园</p>
			<div class={styles.pills}>
				<a class:list={[styles.pill, styles.pillPrimary]} href="https://www.yuque.com/" target="_blank" rel="noopener">
					<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
						<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
					</svg>
					<span>语雀</span>
				</a>
				<a class:list={[styles.pill, styles.pillAccent]} href="/posts">
					<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
						<path d="M12 2c1 3 4 4 4 8a4 4 0 0 1-8 0c0-2 1-3 2-4-.5 2 .5 3 2 3 0-2-1-4 0-7z" />
					</svg>
					<span>热门</span>
				</a>
			</div>
		</div>

		<div class={styles.right}>
			<ul class={styles.grid}>
				{
					cards.map((card) => (
						<li>
							<a class={styles.card} href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel={card.href.startsWith('http') ? 'noopener' : undefined}>
								<span class={styles.cardIcon} style={`color: ${card.color}`}>
									<svg viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
										<path d={card.icon} />
									</svg>
								</span>
								<span class={styles.cardBody}>
									<span class={styles.cardName}>{card.name}</span>
									<span class={styles.cardDesc}>{card.desc}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
