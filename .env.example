# Immich 相册集成
# /gallery 页面会在构建时从 Immich 拉取相册数据，并将略缩图 URL 拼接到 <img src> 中。
# 注意：API key 会以查询参数形式出现在生成的静态 HTML 中，请使用只读 / 范围最小的 key。
IMMICH_API_URL=https://api.mahoo12138.cn/immich
IMMICH_API_KEY=
IMMICH_ALBUM_NAME=测试相册

# 高德地图（/travel 页面用）
# key 需要在 https://console.amap.com/dev/key/app 申请，并将站点域名加入白名单
# 注意：作为 PUBLIC_ 变量会出现在生成的静态 HTML 中，请勾选 Web 端 (JS API) 类型，并在控制台配置域名白名单
PUBLIC_AMAP_KEY=
# 如果在控制台为 key 启用了"安全密钥"，请填写；否则留空
PUBLIC_AMAP_SECURITY_CODE=

# Artalk 评论系统
# 在文章页（BlogPost 布局）底部渲染评论框。两项均为必填，缺一则不渲染。
# ARTALK_SERVER: Artalk 后端地址（不含末尾斜杠），例如 https://artalk.example.com
# ARTALK_SITE:   在 Artalk 后台「站点管理」里注册的站点名称，必须完全一致
ARTALK_SERVER=
ARTALK_SITE=
