---
/**
 * 「跳到主内容」跳转链接。
 *
 * 键盘用户和屏幕阅读器用户在每个页面都要先 tab 过整条侧栏菜单才能到达正文，
 * 这个链接让他们一步跳到 <main>。默认视觉隐藏，聚焦时出现在左上角。
 *
 * 各 Shell 的 <main> 都带 data-pagefind-body，但这里不依赖它，
 * 而是用显式 id="main-content" 保证锚点稳定（pagefind 属性是搜索用途，语义会变）。
 *
 * 配色走 vanilla-extract 的 vars.color.accent，这样明暗主题都会跟着变
 * （浅色 #2196f3 / 深色 #7ecbff）。注意不能写死 CSS 变量名：
 * vanilla-extract 会把变量名混淆成哈希，手写 var(--accent) 不可能命中。
 */
import { vars } from '../styles/theme.css';

interface Props {
	/** 要跳转到的目标元素 id，默认 main-content */
	target?: string;
	label?: string;
}

const { target = 'main-content', label = '跳到主内容' } = Astro.props;
---

<a class="skip-link" href={`#${target}`}>{label}</a>

<style is:global define:vars={{ accentStrong: vars.color.accentStrong, contrast: vars.color.surfaceStrong }}>
	.skip-link {
		position: fixed;
		top: 0;
		transform: translateY(calc(-100% - 16px));
		opacity: 0;
		pointer-events: none;
		left: 0;
		z-index: 9999;
		padding: 0.6rem 1.1rem;
		background: var(--accentStrong, #365b81);
		color: var(--contrast, #fff);
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.8;
		text-decoration: none;
		border-radius: 0 0 8px 0;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
		transition: transform 0.18s ease, opacity 0.18s ease;
	}

	.skip-link:focus,
	.skip-link:focus-visible {
		transform: translateY(0);
		opacity: 1;
		pointer-events: auto;
		outline: 2px solid var(--contrast, #fff);
		outline-offset: -4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.skip-link {
			transition: none;
		}
	}

	/* 打印时不需要跳转链接 */
	@media print {
		.skip-link {
			display: none;
		}
	}
</style>
