---
import '../styles/theme.css.ts';
// 代码块外壳（语言标签 + 复制按钮）样式。
// 放在 BaseHead 是因为代码块可能出现在任何渲染 Markdown 的页面，
// 这里是全站唯一的公共入口，能保证样式一定被引入。
import '../styles/codeBlock.css.ts';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/avatar.png';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import UmamiAnalytics from './UmamiAnalytics.astro';
import { siteFontConfig } from '../config/fonts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	/** 功能页 / 内部预览页用，输出 robots noindex 阻止收录 */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 未显式传图时的 og:image 兜底。源 avatar.png 为 1056×992 / 738KB 的 PNG，
// 直接把原图 URL 塞进 og:image 会让社交平台抓取端白白下载 738KB。
// 这里走图片管线压成 512px 宽的 JPEG（约 40KB），兼容性也优于 webp。
const fallbackOgImage = await getImage({ src: FallbackImage, width: 512, format: 'jpeg' });

const { title, description, image = fallbackOgImage, type = 'website', publishedTime, modifiedTime, noindex = false } = Astro.props;

// og:image 既支持本地 ImageMetadata，也支持远程 URL 字符串
const ogImage = typeof image === 'string' ? new URL(image, Astro.url) : new URL(image.src, Astro.url);

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site?.toString(),
	author: { '@type': 'Person', name: SITE_AUTHOR },
};

const safeStringify = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<ClientRouter />

<script is:inline>
	(() => {
		const themeStorageKey = 'theme-preference';

		try {
			const theme = localStorage.getItem(themeStorageKey);
			if (theme === 'light' || theme === 'dark') {
				document.documentElement.dataset.theme = theme;
				return;
			}
		} catch {}

		document.documentElement.removeAttribute('data-theme');
	})();

	document.addEventListener('astro:before-swap', (event) => {
		const currentTheme = document.documentElement.dataset.theme;
		if (currentTheme) {
			event.newDocument.documentElement.dataset.theme = currentTheme;
		}
	});
</script>

<!-- 字体加载策略（optimization-plan P1-1）
     Google Fonts 对中文字体（Noto Sans/Serif SC）返回的是 642 条 @font-face
     的 unicode-range 分包 CSS，实测 690KB。若用普通 <link rel="stylesheet">
     引入，这份 CSS 会在每个页面阻塞首次渲染，且必须先串行完成
     fonts.googleapis.com 的连接 → 拿到 CSS → 才知道要下载哪些字体分包。
     这里的做法：
       1) 用 media="print" + onload 切换的方式让 CSS 异步化，不阻塞渲染；
          同时用 noscript 标签兜底，保证无 JS 环境仍有字体。
       2) preconnect 保留，让异步请求尽早建连。
     字体本身仍是按需分包下载（浏览器只取当前页面字形所在的分包），
     配合 display=swap 先出系统字体，不会出现长时间空白文本。
     注：中文子集自托管需要 cn-font-split 级别的工具链与 ~60MB 产物，
     收益不抵复杂度，故仍用 Google 的按需分包，只消除其阻塞性。 -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href={siteFontConfig.googleFontsUrl}
	media="print"
	onload="this.media='all'"
/>
<noscript>
	<link rel="stylesheet" href={siteFontConfig.googleFontsUrl} />
</noscript>

{/* 代码块复制按钮的行为。
    走外部静态文件而不是 is:inline：实测内联版 4.86KB × 236 页 = 1.09MB，
    而其中 130 页根本没有代码块；外部文件全站只下载一次并可被缓存。
    defer 保证在 DOM 就绪后执行，不阻塞解析。
    无 JS 时按钮不可用，其隐藏逻辑放在 codeBlock.css.ts 里用
    html.no-js 兜底（见该文件注释）。 */}
<script src="/js/code-copy.js" defer></script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- JSON-LD: WebSite -->
<script is:inline type="application/ld+json" set:html={safeStringify(websiteJsonLd)} />

<UmamiAnalytics />
