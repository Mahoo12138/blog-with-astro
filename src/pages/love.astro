---
import { getCollection } from "astro:content";
import { getExploreInternalItemByHref } from "../config/explore";
import ExploreShell from "../layouts/ExploreShell.astro";

const item = getExploreInternalItemByHref("/love/");

if (!item) {
  throw new Error("Explore item for /love/ was not found.");
}

const sortById = <T extends { id: string }>(entries: T[]) =>
  [...entries].sort((a, b) => a.id.localeCompare(b.id));

const [
  timeline,
  photos,
  firsts,
  stats,
  traits,
  destinations,
  wishes,
  promises,
  dateIdeas,
  loveNotes,
] = await Promise.all([
  getCollection("loveTimeline"),
  getCollection("lovePhotos"),
  getCollection("loveFirsts"),
  getCollection("loveStats"),
  getCollection("loveTraits"),
  getCollection("loveDestinations"),
  getCollection("loveWishes"),
  getCollection("lovePromises"),
  getCollection("loveDateIdeas"),
  getCollection("loveNotes"),
]);

const meta = {
  startDate: "2025-12-06",
  anniversaryDate: "2026-12-06",
  anniversaryLabel: "一周年 · 2026.12.06",
  partners: {
    left: { initial: "她", name: "小A" },
    right: { initial: "他", name: "小B" },
  },
  song: {
    title: "光年之外",
    artist: "G.E.M. 邓紫棋",
    note: '"第一次牵手的那天，这首歌刚好在播。"',
    initialTime: "1:23",
    totalTime: "3:43",
    initialPercent: 37,
  },
  letter: {
    date: "2026 · 05 · 20",
    greeting: "亲爱的你，",
    paragraphs: [
      "想对你说的话有很多，却总是不知道从哪里开始。",
      "喜欢你不是因为某一件事，而是你所有细小的样子加在一起，刚好成了我最想靠近的人。",
      "喜欢你认真讲话时的样子，喜欢你笑起来的样子，喜欢你说\"我知道了\"却还是会忘记的样子。",
      "谢谢你愿意留在我身边，谢谢你让我相信，平凡的日子也可以这么闪光。",
      "希望我们可以一直这样下去，把所有的四季都过一遍，再过一遍。",
    ],
    signature: "— 永远爱你的我 ♡",
  },
};

const month = new Date().getMonth() + 1;
const currentSeason =
  month >= 3 && month <= 5
    ? "spring"
    : month >= 6 && month <= 8
      ? "summer"
      : month >= 9 && month <= 11
        ? "autumn"
        : "winter";

const timelineEntries = sortById(timeline);
const photoEntries = sortById(photos);
const firstsEntries = sortById(firsts);
const statsEntries = sortById(stats);
const traitsEntries = sortById(traits);
const destinationsEntries = sortById(destinations);
const wishesEntries = sortById(wishes);
const promisesEntries = sortById(promises);
const dateIdeasEntries = sortById(dateIdeas);
const notesEntries = sortById(loveNotes);

const wishesDone = wishesEntries.filter((w) => w.data.done).length;

const delayCls = (i: number, max = 9) => `d${(i % max) + 1}`;

const dateIdeasPayload = dateIdeasEntries.map((d) => ({
  ic: d.data.icon,
  tt: d.data.title,
  tx: d.data.description,
}));

const initialIdea = dateIdeasPayload[0];
---

<ExploreShell item={item}>
  <div class="love-root" data-season={currentSeason} id="love-root">
    <div id="cg"></div>
    <canvas id="bg"></canvas>
    <div id="prog"></div>

    <!-- HERO -->
    <header class="hero">
      <div class="h-grid"></div>
      <div class="h-bg">LOVE</div>
      <div class="orb o1"></div>
      <div class="orb o2"></div>
      <div class="orb o3"></div>
      <div class="hc">
        <p class="hen">Love Story · 恋爱纪念册</p>
        <h1 class="htl">我们的故事</h1>
        <p class="hsb">每一天都是礼物，每一刻都值得珍藏</p>
        <div class="avs">
          <div class="av">
            <div class="av-ring"><div class="av-img">{meta.partners.left.initial}</div></div>
            <div class="av-nm">{meta.partners.left.name}</div>
          </div>
          <div class="av-cn">
            <div class="av-ht">♡</div>
            <div class="av-dy" id="av-dy">···</div>
          </div>
          <div class="av">
            <div class="av-ring"><div class="av-img">{meta.partners.right.initial}</div></div>
            <div class="av-nm">{meta.partners.right.name}</div>
          </div>
        </div>
      </div>
      <div class="scroll-cue"><div class="sc-arr"></div><span>向下探索</span></div>
    </header>

    <!-- 01 · 倒计时 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0" style="justify-content:center;">
          <div class="sh-l r"></div><h2>在一起的时光</h2><div class="sh-l"></div>
        </div>
        <div class="cd-main a0 d1">
          <div class="cd-from">{meta.startDate.replace(/-/g, " · ")} → 至今</div>
          <div class="cd-row">
            <div class="cd-blk"><span class="cd-n" id="cd-d">0</span><span class="cd-u">天</span></div>
            <span class="cd-dot">·</span>
            <div class="cd-blk"><span class="cd-n" id="cd-h">00</span><span class="cd-u">时</span></div>
            <span class="cd-dot">·</span>
            <div class="cd-blk"><span class="cd-n" id="cd-m">00</span><span class="cd-u">分</span></div>
            <span class="cd-dot">·</span>
            <div class="cd-blk"><span class="cd-n" id="cd-s">00</span><span class="cd-u">秒</span></div>
          </div>
          <p class="cd-cap">已经 <strong id="cd-ds">0</strong> 天了，感谢你还在</p>
          <div class="cd-nx a0 d2">
            <div class="cdl">
              <div class="a">下一个纪念日</div>
              <div class="b">{meta.anniversaryLabel}</div>
            </div>
            <div class="cdr">
              <div class="n" id="cd-an">0</div>
              <div class="u">天后</div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 02 · 时间线 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>我们走过的路</h2><div class="sh-l"></div></div>
        <div class="tl">
          {timelineEntries.map((entry, i) => (
            <div class:list={["tli", "al", delayCls(i)]}>
              <div class="tl-dot"></div>
              <div class="tl-badge">{entry.data.badge}</div>
              <div class="tl-date">{entry.data.date}</div>
              <div class="tl-ev">{entry.data.title}</div>
              <div class="tl-desc">{entry.data.description}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 03 · 相册 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0">
          <h2>相册记忆</h2><div class="sh-l"></div>
          <span class="sh-tag">{photoEntries.length} 个瞬间</span>
        </div>
        <div class="ph-grid">
          {photoEntries.map((entry, i) => (
            <div class:list={["ph-card", "sc2", delayCls(i)]}>
              <div class="ph-bg" style={`background:${entry.data.gradient};position:absolute;inset:0;`}></div>
              <div class="ph-ov">
                <div class="ph-dt">{entry.data.date}</div>
                <div class="ph-tt">{entry.data.title}</div>
                <div class="ph-tx">{entry.data.caption}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 04 · 第一次 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>我们的第一次</h2><div class="sh-l"></div></div>
        <div class="fg">
          {firstsEntries.map((entry, i) => (
            <div class:list={["fc", "glass", "tilt", "a0", delayCls(i)]}>
              <div class="fc-ic">{entry.data.icon}</div>
              <div class="fc-tt">{entry.data.title}</div>
              <div class="fc-dt">{entry.data.date}</div>
              <div class="fc-tx">{entry.data.description}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 05 · 统计 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>我们一起做了什么</h2><div class="sh-l"></div></div>
        <div class="sg">
          {statsEntries.map((entry, i) => (
            <div
              class:list={["sc3", "glass", "tilt", "a0", delayCls(i)]}
              data-t={entry.data.target}
              data-suffix={entry.data.suffix}
            >
              <div class="sc3-ic">{entry.data.icon}</div>
              <div class="sc3-n">{entry.data.target}{entry.data.suffix}</div>
              <div class="sc3-l">{entry.data.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 06 · 我眼中的你 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0" style="justify-content:center;">
          <div class="sh-l r"></div><h2>我眼中的你</h2><div class="sh-l"></div>
        </div>
        <p class="trait-intro a0 d1">
          有很多话不知道怎么说，<br />
          但你所有的样子我都记得。
        </p>
        <div class="trait-wrap">
          {traitsEntries.map((entry, i) => (
            <div
              class:list={[
                "tp",
                entry.data.size === "lg" && "lg",
                entry.data.size === "sm" && "sm",
                "a0",
                delayCls(i, 6),
              ]}
            >
              <span class="tp-ic">{entry.data.icon}</span>{entry.data.label}
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 07 · 歌 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>我们的歌</h2><div class="sh-l"></div></div>
        <div class="song-wrap glass a0 d1">
          <div class="song-hd"></div>
          <div class="song-bd">
            <div class="song-art">🎵</div>
            <div class="song-inf">
              <div class="t">{meta.song.title}</div>
              <div class="ar">{meta.song.artist}</div>
              <div class="nt">{meta.song.note}</div>
            </div>
          </div>
          <div class="song-ft">
            <div class="sb">
              <span class="stm" id="cur-t">{meta.song.initialTime}</span>
              <div class="str"><div class="sfl" id="sfl" style={`width:${meta.song.initialPercent}%;`}></div></div>
              <span class="stm">{meta.song.totalTime}</span>
            </div>
            <div class="sct">
              <button class="sbt" aria-label="上一首">⏮</button>
              <button class="sbt pl" id="pbtn">▶</button>
              <button class="sbt" aria-label="下一首">⏭</button>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 08 · 目的地 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0">
          <h2>我们去过的地方</h2><div class="sh-l"></div>
          <span class="sh-tag">{destinationsEntries.filter((d) => d.data.visited).length} 个足迹</span>
        </div>
        <div class="dr a0 d1">
          {destinationsEntries.map((entry) => (
            <div class:list={["dc", "glass", !entry.data.visited && "ft"]}>
              <div class="dc-no">{entry.data.number}</div>
              <div class="dc-ct">{entry.data.city}</div>
              <div class="dc-nt">{entry.data.description}</div>
              <div class="dc-tg">{entry.data.tag}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 09 · 心愿 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0">
          <h2>我们的心愿</h2><div class="sh-l"></div>
          <span class="sh-tag" id="wct">{wishesDone} / {wishesEntries.length} 完成</span>
        </div>
        <div class="wl">
          {wishesEntries.map((entry, i) => (
            <div
              class:list={["wi", entry.data.done && "dn", "glass", "a0", delayCls(i)]}
              data-wish
            >
              <div class="wc">{entry.data.done ? "✓" : ""}</div>
              <span class="wt">{entry.data.text}</span>
              <span class="wk">{entry.data.category}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 10 · 约定 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>我们的约定</h2><div class="sh-l"></div></div>
        <div class="pg">
          {promisesEntries.map((entry, i) => (
            <div class:list={["pc", "glass", "tilt", "a0", delayCls(i)]}>
              <div class="pc-ic">{entry.data.icon}</div>
              <div>
                <div class="pc-tt">{entry.data.title}</div>
                <div class="pc-nt">{entry.data.description}</div>
                <div class="pc-tg">{entry.data.tag}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 11 · 约会灵感 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>随机约会灵感</h2><div class="sh-l"></div></div>
        <div class="di-wrap">
          <div class="di-card glass a0 d1">
            <span class="di-ico" id="di-ic">{initialIdea?.ic}</span>
            <div class="di-tt" id="di-tt">{initialIdea?.tt}</div>
            <div class="di-tx" id="di-tx">{initialIdea?.tx}</div>
          </div>
          <button class="di-btn a0 d2" id="di-btn"><span>✦</span> 换一个灵感</button>
          <div class="di-hint a0 d3">共 {dateIdeasPayload.length} 个约会想法 · 总有一个适合今天</div>
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">✦</span><div class="div-l"></div></div>

    <!-- 12 · 纸条 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0"><h2>心动纸条墙</h2><div class="sh-l"></div></div>
        <div class="ng">
          {notesEntries.map((entry, i) => (
            <div class:list={["nc", "glass", "a0", delayCls(i)]}>{entry.data.text}</div>
          ))}
        </div>
      </div>
    </section>
    <div class="div"><div class="div-l"></div><span class="div-ic">◇</span><div class="div-l"></div></div>

    <!-- 13 · 信 -->
    <section class="sec">
      <div class="sec-in">
        <div class="sh a0" style="justify-content:center;">
          <div class="sh-l r"></div><h2>写给你的话</h2><div class="sh-l"></div>
        </div>
        <div class="letter-outer">
          <div class="letter-card glass a0 d1">
            <div class="lc-deco">"</div>
            <div class="lc-date">{meta.letter.date}</div>
            <p class="lc-dear">{meta.letter.greeting}</p>
            <div class="lc-body">
              {meta.letter.paragraphs.map((p) => <p>{p}</p>)}
            </div>
            <div class="lc-sig">{meta.letter.signature}</div>
          </div>
        </div>
      </div>
    </section>

    <footer class="love-footer">
      <div class="f1">永远爱你 <span class="fh">♥</span></div>
      <div class="f2">Love Story · {meta.startDate.replace(/-/g, ".")}</div>
    </footer>
  </div>
</ExploreShell>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600&family=Noto+Sans+SC:wght@300;400;500&display=swap");

  /* ── SEASON VARS ─ */
  .love-root[data-season="spring"]{--bg:#0D0408;--bg2:#180812;--sf:rgba(220,80,110,.07);--gw:#E8547A;--gw2:#FF90B4;--gd:rgba(232,84,122,.1);--gd2:rgba(232,84,122,.22);--tx:#FFE8F2;--txm:rgba(255,232,242,.56);--txh:rgba(255,232,242,.28);--bd:rgba(232,84,122,.2);--bds:rgba(232,84,122,.42);}
  .love-root[data-season="summer"]{--bg:#0A0702;--bg2:#150F04;--sf:rgba(210,140,20,.07);--gw:#E8A020;--gw2:#FFCA60;--gd:rgba(232,160,32,.1);--gd2:rgba(232,160,32,.22);--tx:#FFF8E8;--txm:rgba(255,248,232,.56);--txh:rgba(255,248,232,.28);--bd:rgba(232,160,32,.2);--bds:rgba(232,160,32,.42);}
  .love-root[data-season="autumn"]{--bg:#0C0502;--bg2:#180806;--sf:rgba(200,80,20,.07);--gw:#E06028;--gw2:#FF9058;--gd:rgba(224,96,40,.1);--gd2:rgba(224,96,40,.22);--tx:#FFF0E8;--txm:rgba(255,240,232,.56);--txh:rgba(255,240,232,.28);--bd:rgba(224,96,40,.2);--bds:rgba(224,96,40,.42);}
  .love-root[data-season="winter"]{--bg:#030810;--bg2:#061020;--sf:rgba(40,100,220,.07);--gw:#3C80FF;--gw2:#80B8FF;--gd:rgba(60,128,255,.1);--gd2:rgba(60,128,255,.22);--tx:#E8F2FF;--txm:rgba(232,242,255,.56);--txh:rgba(232,242,255,.28);--bd:rgba(60,128,255,.2);--bds:rgba(60,128,255,.42);}

  .love-root{
    position:relative;
    font-family:'Noto Sans SC',system-ui,sans-serif;
    background:var(--bg);
    color:var(--tx);
    line-height:1.7;
    transition:background .7s,color .7s;
    overflow-x:hidden;
    min-height:100vh;
  }
  .love-root *,.love-root *::before,.love-root *::after{box-sizing:border-box;}
  .love-root #bg{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.45;}
  .love-root #prog{position:fixed;top:0;left:0;height:2px;width:0%;background:linear-gradient(90deg,var(--gw),var(--gw2));z-index:200;transition:background .7s;}
  .love-root #cg{position:fixed;width:340px;height:340px;border-radius:50%;pointer-events:none;z-index:1;transform:translate(-50%,-50%);background:radial-gradient(circle,var(--gd2) 0%,transparent 65%);mix-blend-mode:screen;opacity:.65;transition:background .7s;will-change:transform;}

  /* SCROLL ANIM */
  .love-root .a0{opacity:0;transform:translateY(30px);transition:opacity .85s cubic-bezier(.22,1,.36,1),transform .85s cubic-bezier(.22,1,.36,1);}
  .love-root .al{opacity:0;transform:translateX(-26px);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1);}
  .love-root .ar{opacity:0;transform:translateX(26px);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1);}
  .love-root .sc2{opacity:0;transform:scale(.88);transition:opacity .8s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1);}
  .love-root .a0.v,.love-root .al.v,.love-root .ar.v,.love-root .sc2.v{opacity:1;transform:none;}
  .love-root .d1{transition-delay:.07s}.love-root .d2{transition-delay:.14s}.love-root .d3{transition-delay:.21s}
  .love-root .d4{transition-delay:.28s}.love-root .d5{transition-delay:.35s}.love-root .d6{transition-delay:.42s}
  .love-root .d7{transition-delay:.49s}.love-root .d8{transition-delay:.56s}.love-root .d9{transition-delay:.63s}

  /* HERO */
  .love-root .hero{position:relative;height:100vh;min-height:680px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;}
  .love-root .h-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 85% 75% at 50% 50%,black,transparent);-webkit-mask-image:radial-gradient(ellipse 85% 75% at 50% 50%,black,transparent);pointer-events:none;}
  .love-root .h-bg{position:absolute;font-family:'Ma Shan Zheng',serif;font-size:min(28vw,320px);letter-spacing:.15em;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.03);user-select:none;pointer-events:none;top:50%;transform:translateY(-50%);}
  .love-root .orb{position:absolute;border-radius:50%;filter:blur(90px);pointer-events:none;will-change:transform;transition:background .7s;}
  .love-root .o1{width:380px;height:380px;background:var(--gd2);top:-90px;left:-110px;animation:loveOf1 14s ease-in-out infinite alternate;}
  .love-root .o2{width:300px;height:300px;background:var(--gd);top:80px;right:-90px;animation:loveOf2 18s ease-in-out infinite alternate;}
  .love-root .o3{width:220px;height:220px;background:var(--gd2);bottom:-70px;left:40%;animation:loveOf3 11s ease-in-out infinite alternate;}
  @keyframes loveOf1{to{transform:translate(60px,44px);}}
  @keyframes loveOf2{to{transform:translate(-52px,60px);}}
  @keyframes loveOf3{to{transform:translate(-40px,-32px);}}
  .love-root .hc{position:relative;z-index:2;padding:0 1.5rem;}
  .love-root .hen{font-size:11px;letter-spacing:.25em;text-transform:uppercase;color:var(--txh);margin-bottom:.75rem;}
