---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		// 与 datetime 属性保持同一时区（UTC），避免构建机时区与作者意图时区不一致时
		// 显示日期和 datetime 出现「错位一天」的问题。
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			timeZone: 'UTC',
		})
	}
</time>
