    function rsz(){ cv.width = innerWidth; cv.height = innerHeight; }
    window.addEventListener('resize', rsz); rsz();

    class P {
      constructor(t, c, r){ this.t = t; this.c = c; this.col = c[~~(Math.random()*c.length)]; this.ini(r); }
      ini(r){
        const W = cv.width, H = cv.height;
        this.x = Math.random()*W; this.s = Math.random()*8+4; this.op = Math.random()*.5+.2;
        if (this.t === 'firefly') {
          this.y = r ? Math.random()*H : H + 10;
          this.vy = -(Math.random()*.9 + .3);
          this.vx = (Math.random()-.5)*.5;
          this.ph = Math.random()*Math.PI*2;
          this.ps = Math.random()*.035+.012;
        } else {
          this.y = r ? Math.random()*H : -15;
          this.vy = Math.random()*1.2 + .45;
          this.vx = (Math.random()-.5)*.9;
          this.wb = Math.random()*Math.PI*2;
          this.ws = Math.random()*.04 + .012;
          this.wa = Math.random()*1.4 + .5;
        }
        if (this.t === 'petal' || this.t === 'leaf') {
          this.rot = Math.random()*Math.PI*2;
          this.rs = (Math.random()-.5)*.045;
        }
        if (this.t === 'snow') { this.s = Math.random()*5+3; this.br = Math.random() < .5 ? 4 : 6; }
      }
      upd(){
        if (this.t === 'firefly') {
          this.ph += this.ps; this.y += this.vy; this.x += this.vx + Math.sin(this.ph)*.45;
          this.op = .28 + Math.abs(Math.sin(this.ph))*.48;
          if (this.y < -15) this.ini(false);
        } else {
          this.wb += this.ws; this.y += this.vy; this.x += this.vx + Math.sin(this.wb)*this.wa;
          if (this.rot !== undefined) this.rot += this.rs;
          if (this.y > cv.height + 20 || this.x < -40 || this.x > cv.width + 40) this.ini(false);
        }
      }
      drw(){
        ctx.save();
        ctx.globalAlpha = Math.max(0, Math.min(1, this.op));
        ctx.translate(this.x, this.y);
        if (this.rot !== undefined) ctx.rotate(this.rot);
        const s = this.s;
        if (this.t === 'petal') {
          ctx.fillStyle = this.col;
          ctx.beginPath(); ctx.ellipse(0, 0, s*.5, s*.85, 0, 0, Math.PI*2); ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,.22)';
          ctx.beginPath(); ctx.ellipse(0, -s*.15, s*.18, s*.38, 0, 0, Math.PI*2); ctx.fill();
        } else if (this.t === 'firefly') {
          const g = ctx.createRadialGradient(0, 0, 0, 0, 0, s*2.5);
          g.addColorStop(0, this.col); g.addColorStop(1, 'rgba(255,200,50,0)');
          ctx.fillStyle = g;
          ctx.beginPath(); ctx.arc(0, 0, s*2.5, 0, Math.PI*2); ctx.fill();
          ctx.fillStyle = this.col;
          ctx.beginPath(); ctx.arc(0, 0, s*.35, 0, Math.PI*2); ctx.fill();
        } else if (this.t === 'leaf') {
          ctx.fillStyle = this.col;
          ctx.beginPath();
          ctx.moveTo(0, -s);
          ctx.bezierCurveTo(s*.85, -s*.5, s*.85, s*.5, 0, s);
          ctx.bezierCurveTo(-s*.85, s*.5, -s*.85, -s*.5, 0, -s);
          ctx.fill();
          ctx.strokeStyle = 'rgba(255,255,255,.18)'; ctx.lineWidth = .5;
          ctx.beginPath(); ctx.moveTo(0, -s); ctx.lineTo(0, s); ctx.stroke();
        } else if (this.t === 'snow') {
          ctx.strokeStyle = this.col; ctx.lineWidth = 1.2;
          for (let i = 0; i < this.br; i++) {
            ctx.save();
            ctx.rotate(i*Math.PI*2/this.br);
            ctx.beginPath();
            ctx.moveTo(0, 0); ctx.lineTo(0, s);
            ctx.moveTo(0, s*.42); ctx.lineTo(s*.3, s*.7);
            ctx.moveTo(0, s*.42); ctx.lineTo(-s*.3, s*.7);
            ctx.stroke();
            ctx.restore();
          }
        }
        ctx.restore();
      }
    }
    function rebuildPts(s){
      const d = SD[s];
      pts = Array.from({ length: s === 'summer' ? 26 : 38 }, () => new P(d.p, d.c, true));
    }
    function loop(){
      ctx.clearRect(0, 0, cv.width, cv.height);
      pts.forEach(p => { p.upd(); p.drw(); });
      requestAnimationFrame(loop);
    }
    rebuildPts(cS); loop();

    /* PARALLAX */
    let raf = null;
    function doPx(){
      const sy = window.scrollY;
      root.querySelectorAll('.orb').forEach((b, i) => {
        const r = [.18, .32, .12];
        b.style.transform = `translateY(${sy*r[i]}px)`;
      });
      raf = null;
    }
    window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(doPx); }, { passive: true });

    /* PROGRESS BAR */
    const prog = document.getElementById('prog');
    window.addEventListener('scroll', () => {
      prog.style.width = (window.scrollY/(document.body.scrollHeight - innerHeight)*100) + '%';
    }, { passive: true });

    /* SCROLL ANIM */
    const obs = new IntersectionObserver(en => {
      en.forEach(e => { if (e.isIntersecting) e.target.classList.add('v'); });
    }, { threshold: 0.07, rootMargin: '0px 0px -28px 0px' });
    root.querySelectorAll('.a0, .al, .ar, .sc2').forEach(el => obs.observe(el));

    /* CURSOR GLOW */
    const cg = document.getElementById('cg');
    document.addEventListener('mousemove', e => {
      cg.style.left = e.clientX + 'px';
      cg.style.top = e.clientY + 'px';
    }, { passive: true });

    /* 3D TILT */
    root.querySelectorAll('.tilt').forEach(el => {
      el.addEventListener('mousemove', e => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left)/r.width - .5;
        const y = (e.clientY - r.top)/r.height - .5;
        el.style.transform = `perspective(520px) rotateX(${-y*9}deg) rotateY(${x*9}deg) translateY(-4px)`;
        el.style.boxShadow = `${-x*12}px ${-y*12}px 28px var(--gd)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = '';
        el.style.boxShadow = '';
      });
    });

    /* COUNTDOWN */
    const startMs = new Date(startDate + 'T00:00:00').getTime();
    const annivMs = new Date(anniversaryDate + 'T00:00:00').getTime();
    function tick(){
      const d = Date.now() - startMs;
      const dy = Math.floor(d/864e5);
      const h = Math.floor((d%864e5)/36e5);
      const m = Math.floor((d%36e5)/6e4);
      const s = Math.floor((d%6e4)/1e3);
      document.getElementById('cd-d').textContent = dy;
      document.getElementById('cd-h').textContent = String(h).padStart(2, '0');
      document.getElementById('cd-m').textContent = String(m).padStart(2, '0');
      document.getElementById('cd-s').textContent = String(s).padStart(2, '0');
      document.getElementById('cd-ds').textContent = dy;
      document.getElementById('cd-an').textContent = Math.max(0, Math.ceil((annivMs - Date.now())/864e5));
      document.getElementById('av-dy').textContent = dy + ' 天';
    }
    tick(); setInterval(tick, 1000);

    /* COUNT-UP */
    function countUp(el, n, plus, dur = 1400){
      const s = Date.now();
      function step(){
        const t = Math.min((Date.now() - s)/dur, 1);
        const ease = 1 - Math.pow(1 - t, 3);
        el.textContent = Math.floor(n*ease) + (t >= 1 && plus ? '+' : '');
        if (t < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }
    const sObs = new IntersectionObserver(en => {
      en.forEach(e => {
        if (e.isIntersecting && !e.target.dataset.done) {
          e.target.dataset.done = '1';
          const target = parseInt(e.target.dataset.t || '0', 10);
          if (!target) return;
          const suffix = e.target.dataset.suffix || '';
          countUp(e.target.querySelector('.sc3-n'), target, suffix === '+');
        }
      });
    }, { threshold: .3 });
    root.querySelectorAll('.sc3[data-t]').forEach(el => sObs.observe(el));

    /* WISHLIST */
    const wct = document.getElementById('wct');
    function refreshWishCount(){
      const all = root.querySelectorAll('.wi').length;
      const dn = root.querySelectorAll('.wi.dn').length;
      wct.textContent = `${dn} / ${all} 完成`;
    }
    root.querySelectorAll('[data-wish]').forEach(el => {
      el.addEventListener('click', () => {
        el.classList.toggle('dn');
        el.querySelector('.wc').textContent = el.classList.contains('dn') ? '✓' : '';
        refreshWishCount();
      });
    });

    /* SONG */
    const pbtn = document.getElementById('pbtn');
    const sfl = document.getElementById('sfl');
    const curT = document.getElementById('cur-t');
    const totalParts = songTotal.split(':').map(Number);
    const totalSec = totalParts[0]*60 + totalParts[1];
    let playing = false;
    let pct = initialPercent;
    let timer = null;
    pbtn.addEventListener('click', () => {
      playing = !playing;
      pbtn.textContent = playing ? '⏸' : '▶';
      if (playing) {
        timer = setInterval(() => {
          pct = Math.min(100, pct + .05);
          sfl.style.width = pct + '%';
          const c = totalSec*pct/100;
          curT.textContent = Math.floor(c/60) + ':' + String(~~(c%60)).padStart(2, '0');
          if (pct >= 100) {
            clearInterval(timer);
            playing = false;
            pbtn.textContent = '▶';
            pct = 0;
          }
        }, 100);
      } else {
        clearInterval(timer);
      }
    });

    /* DATE IDEAS */
    let lastIdx = 0;
    const diIc = document.getElementById('di-ic');
    const diTt = document.getElementById('di-tt');
    const diTx = document.getElementById('di-tx');
    document.getElementById('di-btn').addEventListener('click', () => {
      let idx;
      do { idx = ~~(Math.random()*ideas.length); } while (idx === lastIdx && ideas.length > 1);
      lastIdx = idx;
      diIc.classList.remove('spin');
      void diIc.offsetWidth;
      diIc.classList.add('spin');
      diIc.textContent = ideas[idx].ic;
      diTt.textContent = ideas[idx].tt;
      diTx.textContent = ideas[idx].tx;
    });
  })();
</script>
