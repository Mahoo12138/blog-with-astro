---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArtalkComments from '../components/ArtalkComments.astro';
import FormattedDate from '../components/FormattedDate.astro';
import KatexStyles from '../components/KatexStyles.astro';
import StellarIcon from '../components/StellarIcon.astro';
import type { SiteTreeKey } from '../config/stellar';
import { SITE_AUTHOR, columnUrl, postCommentKey } from '../consts';
import { postHref, slugifySegment, type ResolvedPostCover } from '../utils/content';
import { bannerTint } from '../utils/banner';
import StellarShell from './StellarShell.astro';
import * as chapterStyles from '../styles/columnChapters.css';
import * as styles from './BlogPost.css';

/**
 * 章节所在的专栏上下文。
 *
 * 有了它，章节页就不再是一篇「孤立文章」：顶部显示所属专栏与位置，
 * 底部给出上一章 / 下一章，侧栏渲染专栏目录并高亮当前章 ——
 * 这正是专栏与博客在阅读方式上的根本区别。
 */
export interface ColumnChapterContext {
	title: string;
	slug: string;
	description?: string;
	icon?: string;
	/** 按阅读顺序排好的全部章节 */
	posts: CollectionEntry<'posts'>[];
	/** 当前章节在 posts 中的下标 */
	index: number;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	/** 页头封面 + OG 图的同一个来源（字段已收敛为单一 cover） */
	cover?: ResolvedPostCover | null;
	categories?: string[];
	tags?: string[];
	siteTree?: SiteTreeKey;
	headings?: { depth: number; slug: string; text: string }[];
	mathjax?: boolean;
	noindex?: boolean;
	/** 文章稳定标识，用于评论关联（不含专栏层级，见 postCommentKey 注释）。
	 *  可选：about / mdx-components 这类非文章页也复用本布局，它们没有文章身份。 */
	postId?: string;
	columnContext?: ColumnChapterContext;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	cover,
	categories = [],
	tags = [],
	siteTree,
	headings = [],
	mathjax = false,
	noindex = false,
	postId,
	columnContext,
} = Astro.props;

const resolvedSiteTree: SiteTreeKey = siteTree ?? (columnContext ? 'column' : 'post');

// 评论 key 用文章的稳定标识而不是当前 URL：专栏章节的地址从 /post/<id>/
// 迁到 /columns/<专栏>/<id>/ 之后，历史评论仍然落在同一个 key 上。
// 非文章页（没有 postId）回退到路径，与改动前的行为一致。
const commentKey = postId ? postCommentKey(postId) : Astro.url.pathname;

const chapterPosts = columnContext?.posts ?? [];
const prevChapter = columnContext && columnContext.index > 0 ? chapterPosts[columnContext.index - 1] : undefined;
const nextChapter =
	columnContext && columnContext.index >= 0 && columnContext.index < chapterPosts.length - 1
		? chapterPosts[columnContext.index + 1]
		: undefined;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// 文章 OG / JSON-LD 用的图片 URL：与页头封面同源（单一 cover 字段）
const coverSrc = cover?.src;
const articleImageUrl = coverSrc
	? new URL(typeof coverSrc === 'string' ? coverSrc : coverSrc.src, Astro.site).toString()
	: undefined;

// 页头在无封面时的兜底色相：由文章身份确定性派生，同一篇永远是同一个色
const tint = bannerTint(postId ?? title);
const primaryCategory = categories.find(Boolean);
const tagList = tags.filter(Boolean).slice(0, 3);
const blogPostingJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	author: { '@type': 'Person', name: SITE_AUTHOR },
	mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.toString() },
	...(articleImageUrl ? { image: articleImageUrl } : {}),
};
const blogPostingJsonLdSafe = JSON.stringify(blogPostingJsonLd).replace(/</g, '\\u003c');
---

<StellarShell
	title={title}
	description={description}
	mainClass={styles.main}
	siteTree={resolvedSiteTree}
	tocHeadings={headings}
	type="article"
	image={coverSrc}
	publishedTime={pubDate}
	modifiedTime={updatedDate}
	noindex={noindex}
	column={columnContext
		? {
				title: columnContext.title,
				description: columnContext.description,
				icon: columnContext.icon,
				count: chapterPosts.length,
				posts: chapterPosts,
			}
		: undefined}
>
	{mathjax && <KatexStyles />}
	<script is:inline type="application/ld+json" set:html={blogPostingJsonLdSafe} />
	<article class={styles.article} data-pagefind-body={noindex ? undefined : true}>
		<header
			class:list={[styles.postBanner, 'article', 'banner', 'top']}
			data-cover={cover ? 'true' : 'false'}
			style={tint.style}
		>
			{
				cover && (
					<div class={styles.bannerMedia} aria-hidden="true">
						{cover.isLocal ? (
							<Image class={styles.bannerImage} src={cover.src as ImageMetadata} alt="" loading="eager" decoding="async" />
						) : (
							<img class={styles.bannerImage} src={cover.src as string} alt="" loading="eager" decoding="async" fetchpriority="high" />
						)}
					</div>
				)
			}
			<div class={styles.bannerScrim} aria-hidden="true"></div>
			<div class={styles.bannerGrain} aria-hidden="true"></div>
			<div class={styles.bannerBody}>
				<div class={styles.bannerTop}>
					<div class={styles.crumbRow}>
						<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/">Home</a>
						<span class="sep">/</span>
						{
							columnContext ? (
								<>
									<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/columns">
										专栏
									</a>
									<span class="sep">/</span>
									<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href={columnUrl(columnContext.slug)}>
										{columnContext.title}
									</a>
								</>
							) : (
								<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/posts">
									Blog
								</a>
							)
						}
					</div>
					{
						columnContext && (
							<a
								class:list={[styles.chip, styles.chipAccent]}
								href={columnUrl(columnContext.slug)}
							>
								<StellarIcon name="stellar:menu-columns" class={styles.chipIcon} />
								<span>第 {columnContext.index + 1} / {chapterPosts.length} 章</span>
							</a>
						)
					}
				</div>
				<div class={styles.bannerFoot}>
					<div class={styles.kickerRow}>
						{
							primaryCategory && (
								<a class:list={[styles.chip, styles.chipAccent]} href={`/categories/${slugifySegment(primaryCategory)}/`}>
									<StellarIcon name="default:category" class={styles.chipIcon} />
									<span>{primaryCategory}</span>
								</a>
							)
						}
						{tagList.map((tag) => (
							<a class={styles.chip} href={`/tags/${slugifySegment(tag)}/`}>#{tag}</a>
						))}
					</div>
					<div class={styles.accentRule} aria-hidden="true"></div>
					<h1 class={styles.postTitle}>{title}</h1>
					<div class={styles.postMeta}>
						<span><FormattedDate date={pubDate} /></span>
						{
							updatedDate && (
								<>
									<span class="sep">·</span>
									<span>更新于 <FormattedDate date={updatedDate} /></span>
								</>
							)
						}
					</div>
				</div>
			</div>
		</header>
		<div class:list={[styles.prose, 'md-text', 'content']}>
			{
				columnContext && (
					<div class={chapterStyles.columnBar}>
						<a class={chapterStyles.columnBarLink} href={columnUrl(columnContext.slug)}>
							专栏 · {columnContext.title}
						</a>
						<span class={chapterStyles.columnBarPosition}>
							第 {columnContext.index + 1} / {chapterPosts.length} 章
						</span>
					</div>
				)
			}
			<slot />
		</div>
		{
			columnContext && (
				<>
					<nav class={chapterStyles.nav} aria-label="专栏章节导航">
						{prevChapter ? (
							<a class={chapterStyles.navLink} href={postHref(prevChapter)} rel="prev">
								<span class={chapterStyles.navLabel}>← 上一章</span>
								<span class={chapterStyles.navTitle}>{prevChapter.data.title}</span>
							</a>
						) : (
							<span class:list={[chapterStyles.navLink, chapterStyles.navLinkEmpty]}>
								<span class={chapterStyles.navLabel}>已是第一章</span>
							</span>
						)}
						{nextChapter ? (
							<a
								class:list={[chapterStyles.navLink, chapterStyles.navLinkNext]}
								href={postHref(nextChapter)}
								rel="next"
							>
								<span class={chapterStyles.navLabel}>下一章 →</span>
								<span class={chapterStyles.navTitle}>{nextChapter.data.title}</span>
							</a>
						) : (
							<span class:list={[chapterStyles.navLink, chapterStyles.navLinkNext, chapterStyles.navLinkEmpty]}>
								<span class={chapterStyles.navLabel}>已是最后一章</span>
							</span>
						)}
					</nav>
					<div class={chapterStyles.backToColumn}>
						<a class={chapterStyles.columnBarLink} href={columnUrl(columnContext.slug)}>
							返回专栏目录 →
						</a>
					</div>
				</>
			)
		}
		<ArtalkComments pageKey={commentKey} pageTitle={title} />
	</article>
</StellarShell>
