---
import { getCollection } from 'astro:content';
import ColumnCard from '../../components/ColumnCard.astro';
import Pagination from '../../components/Pagination.astro';
import StellarNavTabs from '../../components/StellarNavTabs.astro';
import StellarPostCard from '../../components/StellarPostCard.astro';
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import * as styles from '../../styles/taxonomy.css';
import { buildColumnBuckets, buildTaxonomyBuckets, sortBlogPosts, type TaxonomyBucket } from '../../utils/content';

export async function getStaticPaths() {
	const posts = sortBlogPosts(await getCollection('posts'));
	// 章节的 categories 已移到专栏上，所以分类桶必须同时看专栏 ——
	// 否则「学习笔记」会少掉整批专栏（STM32 / 数据结构与算法）。
	const columns = buildColumnBuckets(posts, await getCollection('columns'));
	return buildTaxonomyBuckets(posts, 'categories', columns).map((bucket) => ({
		params: { slug: bucket.slug },
		props: { bucket },
	}));
}

interface Props {
	bucket: TaxonomyBucket;
}

const { bucket } = Astro.props as Props;
const totalPages = Math.max(1, Math.ceil(bucket.posts.length / POSTS_PER_PAGE));
const posts = bucket.posts.slice(0, POSTS_PER_PAGE);
const nextUrl = totalPages > 1 ? `/categories/${bucket.slug}/2` : undefined;
---

<StellarShell title={`${bucket.label} · Categories · ${SITE_TITLE}`} description={SITE_DESCRIPTION} mainClass={styles.pageMain} siteTree="index_blog">
	<header class={styles.header}>
		<StellarNavTabs active="categories" />
	</header>
	<h1 class={styles.srOnly}>{bucket.label}</h1>
	<div class={styles.postList}>
		{
			/*
			 * 专栏排在文章之前，且**只出现在第 1 页**。
			 * 一个分类下的专栏最多两三个，不必参与分页；让它们始终在第 1 页更容易被看到。
			 */
			bucket.columns.length > 0 && (
				<div class={styles.topicList}>
					{bucket.columns.map((column) => (
						<ColumnCard column={column} />
					))}
				</div>
			)
		}
		<ul class={styles.list}>
			{
				posts.map((post) => (
					<li class={styles.item}>
						<StellarPostCard post={post} />
					</li>
				))
			}
		</ul>
	</div>
	<Pagination currentPage={1} totalPages={totalPages} nextUrl={nextUrl} />
</StellarShell>
