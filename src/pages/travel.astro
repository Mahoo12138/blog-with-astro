---
import { getCollection } from 'astro:content';
import ExploreShell from '../layouts/ExploreShell.astro';
import { getExploreInternalItemByHref } from '../config/explore';
import * as styles from '../styles/travel.css';

const item = getExploreInternalItemByHref('/travel/');
if (!item) {
	throw new Error('Explore item for /travel/ was not found.');
}

const amapKey = import.meta.env.PUBLIC_AMAP_KEY ?? '';
const amapSecurityCode = import.meta.env.PUBLIC_AMAP_SECURITY_CODE ?? '';

if (!amapKey) {
	console.warn('[travel] PUBLIC_AMAP_KEY is not configured; the map will not render.');
}

const cities = (await getCollection('cities')).sort((a, b) => a.data.visitedAt.valueOf() - b.data.visitedAt.valueOf());
const residences = (await getCollection('residences')).sort((a, b) => {
	if (a.data.order !== b.data.order) return a.data.order - b.data.order;
	return a.data.since.valueOf() - b.data.since.valueOf();
});

function toDateStr(d: Date) {
	const y = d.getFullYear();
	const m = String(d.getMonth() + 1).padStart(2, '0');
	const day = String(d.getDate()).padStart(2, '0');
	return `${y}-${m}-${day}`;
}

const residenceKindLabel: Record<string, string> = {
	birth: '出生地',
	school: '学生时代',
	university: '大学',
	work: '工作',
	home: '现居',
};

const residenceKindGlyph: Record<string, string> = {
	birth: '出',
	school: '学',
	university: '大',
	work: '工',
	home: '居',
};

const residenceKindAccent: Record<string, string> = {
	birth: '#FA6400',
	school: '#FFB300',
	university: '#32B67A',
	work: '#1BCDFC',
	home: '#F44336',
};

const markersData = cities.map((c) => ({
	id: c.id,
	name: c.data.name,
	nameEn: c.data.nameEn ?? '',
	country: c.data.country,
	region: c.data.region ?? '',
	lat: c.data.lat,
	lng: c.data.lng,
	visitedAt: toDateStr(c.data.visitedAt),
	revisits: (c.data.revisits ?? []).map((d) => toDateStr(d)),
	note: c.data.note ?? '',
}));

const residencesData = residences.map((r) => ({
	id: r.id,
	name: r.data.name,
	nameEn: r.data.nameEn ?? '',
	country: r.data.country,
	province: r.data.province ?? '',
	lat: r.data.lat,
	lng: r.data.lng,
	since: toDateStr(r.data.since),
	until: r.data.until ? toDateStr(r.data.until) : '',
	kind: r.data.kind,
	kindLabel: residenceKindLabel[r.data.kind] ?? r.data.kind,
	glyph: residenceKindGlyph[r.data.kind] ?? '·',
	accent: residenceKindAccent[r.data.kind] ?? '#FA6400',
	note: r.data.note ?? '',
}));

function durationLabel(since: Date, until?: Date) {
	const end = until ?? new Date();
	const months = Math.max(0, (end.getFullYear() - since.getFullYear()) * 12 + (end.getMonth() - since.getMonth()));
	if (months >= 12) {
		const years = Math.floor(months / 12);
		const rem = months % 12;
		return rem > 0 ? `${years} 年 ${rem} 个月` : `${years} 年`;
	}
	return `${months} 个月`;
}
---

<ExploreShell item={item} siteTree="travel">
	<section class={styles.pageRoot} transition:animate="fade">
		<header class={styles.header}>
			<div class={styles.headerMain}>
				<p class={styles.kicker}><span>Travel</span> · 旅行地图</p>
				<h1 class={styles.title}>{item.title}</h1>
				<p class={styles.description}>{item.description}</p>
			</div>
			<div class={styles.headerMeta}>
				<div class={styles.headerStat}>
					<span class={styles.headerStatValue}>{String(cities.length).padStart(2, '0')}</span>
					<small class={styles.headerStatLabel}>Cities</small>
				</div>
				<div class={styles.headerStat}>
					<span class={styles.headerStatValue}>{String(residences.length).padStart(2, '0')}</span>
					<small class={styles.headerStatLabel}>Chapters</small>
				</div>
			</div>
		</header>

		<section class={styles.mapSection}>
			<div class={styles.mapCard} transition:name="travel-map-card">
				<div
					id="travel-map"
					class={styles.map}
					data-cities={JSON.stringify(markersData)}
					data-residences={JSON.stringify(residencesData)}
					role="application"
					aria-label="旅行地图"
				></div>
				<ul class={styles.legend} aria-label="图例">
					<li class={styles.legendItem}>
						<span class={styles.legendDotTravel} aria-hidden="true"></span>
						<span>到访城市</span>
					</li>
					<li class={styles.legendItem}>
						<span class={styles.legendDotResidence} aria-hidden="true"></span>
						<span>人生足迹</span>
					</li>
				</ul>
			</div>
		</section>

		<section class={styles.lifeline}>
			<h2 class={styles.sectionTitle}>人生足迹</h2>
			<ol class={styles.lifelineList}>
				{residences.map((r, idx) => (
					<li class={styles.lifelineItem} style={`--residence-accent:${residenceKindAccent[r.data.kind]};`}>
						<span class={styles.lifelineGlyph} aria-hidden="true">{residenceKindGlyph[r.data.kind]}</span>
						<div class={styles.lifelineBody}>
							<div class={styles.lifelineHead}>
								<span class={styles.lifelineKind}>{residenceKindLabel[r.data.kind]}</span>
								<span class={styles.lifelineCity}>{r.data.name}</span>
								{r.data.province && r.data.province !== r.data.name && <span class={styles.lifelineProvince}>{r.data.province}</span>}
							</div>
							<div class={styles.lifelineRange}>
								<time datetime={toDateStr(r.data.since)}>{toDateStr(r.data.since)}</time>
								<span class={styles.lifelineRangeSep}>→</span>
								{r.data.until ? <time datetime={toDateStr(r.data.until)}>{toDateStr(r.data.until)}</time> : <span class={styles.lifelinePresent}>至今</span>}
								<span class={styles.lifelineDuration}>{durationLabel(r.data.since, r.data.until)}</span>
							</div>
							{r.data.note && <p class={styles.lifelineNote}>{r.data.note}</p>}
						</div>
						{idx < residences.length - 1 && <span class={styles.lifelineConnector} aria-hidden="true"></span>}
					</li>
				))}
			</ol>
		</section>

		<section class={styles.timeline}>
			<h2 class={styles.sectionTitle}>城市清单</h2>
			<ol class={styles.timelineList}>
				{cities.map((c) => {
					const visitCount = 1 + (c.data.revisits?.length ?? 0);
					return (
						<li class={styles.timelineItem}>
							<span class={styles.timelineDate}>{toDateStr(c.data.visitedAt)}</span>
							<div class={styles.timelineBody}>
								<div class={styles.timelineHead}>
									<span class={styles.timelineCity}>{c.data.name}</span>
									{c.data.nameEn && <span class={styles.timelineCityEn}>{c.data.nameEn}</span>}
									<span class={styles.timelineCountry}>{c.data.country}</span>
									{visitCount > 1 && <span class={styles.timelineBadge}>×{visitCount}</span>}
								</div>
								{c.data.note && <p class={styles.timelineNote}>{c.data.note}</p>}
							</div>
						</li>
					);
				})}
			</ol>
		</section>
	</section>
</ExploreShell>

<script is:inline define:vars={{ amapSecurityCode }}>
	if (amapSecurityCode) {
		window._AMapSecurityConfig = { securityJsCode: amapSecurityCode };
	}
</script>
{amapKey && (
	<script is:inline src={`https://webapi.amap.com/maps?v=2.0&key=${amapKey}`}></script>
)}
<script is:inline data-astro-rerun>
	(() => {
		const STYLE_LIGHT = 'amap://styles/whitesmoke';
		const STYLE_DARK = 'amap://styles/dark';

		function getThemeMode() {
			const explicit = document.documentElement.dataset.theme;
			if (explicit === 'light' || explicit === 'dark') return explicit;
			return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		}

		function readJson(el, attr) {
			try { return JSON.parse(el.getAttribute(attr) || '[]'); } catch (e) { return []; }
		}

		function escape(s) {
			return String(s).replace(/[&<>"']/g, (ch) => ({
				'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
			}[ch]));
		}

		function init() {
			const container = document.getElementById('travel-map');
			if (!container) return;
			if (container.dataset.mapReady === '1') return;
			if (typeof window.AMap === 'undefined') {
				setTimeout(init, 60);
				return;
			}
			const AMap = window.AMap;
			const cities = readJson(container, 'data-cities');
			const residences = readJson(container, 'data-residences');

			const mode = getThemeMode();
			const map = new AMap.Map(container, {
				zoom: 4,
				center: [110, 30],
				mapStyle: mode === 'dark' ? STYLE_DARK : STYLE_LIGHT,
				viewMode: '2D',
				features: ['bg', 'road', 'building', 'point'],
				resizeEnable: true,
				doubleClickZoom: true,
				keyboardEnable: false,
				scrollWheel: false,
				touchZoom: true,
				jogEnable: true,
			});
			container.dataset.mapReady = '1';

			const overlays = [];
			const infoWindow = new AMap.InfoWindow({
				offset: new AMap.Pixel(0, -16),
				closeWhenClickMap: true,
				autoMove: true,
			});

			cities.forEach((c) => {
				const marker = new AMap.Marker({
					position: [c.lng, c.lat],
					content: '<div class="travel-marker"><span class="pulse"></span><span class="dot"></span></div>',
					offset: new AMap.Pixel(-7, -7),
					title: c.name,
					anchor: 'center',
					zIndex: 100,
				});
				const revisitsCount = Array.isArray(c.revisits) ? c.revisits.length : 0;
				const totalVisits = 1 + revisitsCount;
				const popupHtml = [
					'<div class="pop-card">',
					'<div class="pop-head">',
						'<span class="pop-city">', escape(c.name), '</span>',
						c.nameEn ? '<span class="pop-en">' + escape(c.nameEn) + '</span>' : '',
					'</div>',
					'<div class="pop-row">点亮于 <strong>', escape(c.visitedAt), '</strong></div>',
					totalVisits > 1 ? '<div class="pop-row">共到访 <strong>' + totalVisits + '</strong> 次</div>' : '',
					c.region ? '<div class="pop-row">' + escape(c.region) + ' · ' + escape(c.country) + '</div>' : '<div class="pop-row">' + escape(c.country) + '</div>',
					c.note ? '<p class="pop-note">' + escape(c.note) + '</p>' : '',
					'</div>',
				].join('');
				marker.on('click', () => {
					infoWindow.setContent(popupHtml);
					infoWindow.open(map, marker.getPosition());
				});
				marker.setMap(map);
				overlays.push(marker);
			});

			const residencePath = [];
			residences.forEach((r) => {
				const html = '<div class="residence-marker">'
					+ '<span class="residence-ring" style="--ring:' + r.accent + ';"></span>'
					+ '<span class="residence-dot" style="--accent:' + r.accent + ';">' + escape(r.glyph || '·') + '</span>'
					+ '</div>';
				const marker = new AMap.Marker({
					position: [r.lng, r.lat],
					content: html,
					offset: new AMap.Pixel(-17, -17),
					title: r.name,
					anchor: 'center',
					zIndex: 200,
				});
				const rangeStr = escape(r.since) + ' → ' + (r.until ? escape(r.until) : '至今');
				const popupHtml = [
					'<div class="pop-card">',
					'<div class="pop-head">',
						'<span class="pop-tag" style="background:' + r.accent + '22;color:' + r.accent + ';">' + escape(r.kindLabel || '') + '</span>',
						'<span class="pop-city">', escape(r.name), '</span>',
						r.nameEn ? '<span class="pop-en">' + escape(r.nameEn) + '</span>' : '',
					'</div>',
					'<div class="pop-row">' + rangeStr + '</div>',
					r.province ? '<div class="pop-row">' + escape(r.province) + ' · ' + escape(r.country) + '</div>' : '<div class="pop-row">' + escape(r.country) + '</div>',
					r.note ? '<p class="pop-note">' + escape(r.note) + '</p>' : '',
					'</div>',
				].join('');
				marker.on('click', () => {
					infoWindow.setContent(popupHtml);
					infoWindow.open(map, marker.getPosition());
				});
				marker.setMap(map);
				overlays.push(marker);
				residencePath.push([r.lng, r.lat]);
			});

			if (residencePath.length > 1) {
				const polyline = new AMap.Polyline({
					path: residencePath,
					strokeColor: '#FA6400',
					strokeWeight: 2.5,
					strokeOpacity: 0.65,
					strokeStyle: 'dashed',
					strokeDasharray: [8, 6],
					zIndex: 50,
				});
				polyline.setMap(map);
			}

			if (overlays.length > 0) {
				map.setFitView(overlays, false, [40, 40, 40, 40], 6);
			}

			container.addEventListener('mouseenter', () => map.setStatus({ scrollWheel: true }));
			container.addEventListener('mouseleave', () => map.setStatus({ scrollWheel: false }));

			let currentMode = mode;
			function swapStyle() {
				const next = getThemeMode();
				if (next === currentMode) return;
				currentMode = next;
				map.setMapStyle(next === 'dark' ? STYLE_DARK : STYLE_LIGHT);
			}
			const observer = new MutationObserver(swapStyle);
			observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (document.documentElement.dataset.theme) return;
				swapStyle();
			});
		}

		init();
	})();
</script>
