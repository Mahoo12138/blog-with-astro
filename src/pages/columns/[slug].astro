---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import { mdxComponents } from '../../components/mdx-components';
import * as styles from '../../layouts/BlogPost.css';
import * as columnStyles from '../../styles/columnPage.css';
import { getColumnBuckets, renderEntry, type ColumnBucket } from '../../lib/data-repository';

export async function getStaticPaths() {
	const buckets = await getColumnBuckets();

	return buckets
		.filter((bucket) => bucket.entry)
		.map((bucket) => ({
			params: { slug: bucket.slug },
			props: { bucket, column: bucket.entry! },
		}));
}

interface Props {
	bucket: ColumnBucket;
	column: CollectionEntry<'columns'>;
}

const { bucket, column } = Astro.props as Props;
const { content: renderedContent, headings } = await renderEntry(column);
const { Content } = renderedContent;
const banner = column.data.banner as ImageMetadata | undefined;
const initial = bucket.title.slice(0, 1);
---

<StellarShell
	title={`${bucket.title} · 专栏 · ${SITE_TITLE}`}
	description={column.data.description || SITE_DESCRIPTION}
	mainClass={columnStyles.main}
	siteTree="column"
	tocHeadings={headings}
	column={{
		title: bucket.title,
		description: bucket.description,
		icon: column.data.icon,
		count: bucket.posts.length,
		posts: bucket.posts,
	}}
>
	<article class={columnStyles.article}>
		<header class:list={[styles.banner, !banner && columnStyles.noBanner, 'article', 'banner', 'top']}>
			{banner ? (
				<Image class:list={[styles.bannerImage, columnStyles.bannerImageShift, 'bg']} width={1020} height={408} src={banner} alt="" />
			) : (
				<div class={columnStyles.bannerFallback} aria-hidden="true">
					<span class={columnStyles.bannerFallbackInitial}>{initial}</span>
				</div>
			)}
			<div class:list={[styles.bannerContent, banner && styles.bannerContentWithImage, 'content']}>
				<div class:list={[styles.bannerMeta, 'top', 'bread-nav', 'footnote']}>
					<div class="left">
						<div class="flex-row" id="breadcrumb">
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/">Home</a>
							<span class="sep">/</span>
							<a class:list={[styles.breadcrumb, 'cap', 'breadcrumb']} href="/columns">专栏</a>
							<span class="sep">/</span>
							<span class:list={[styles.breadcrumb, 'cap', 'breadcrumb']}>{bucket.title}</span>
						</div>
					</div>
				</div>
				<div class:list={[styles.bannerBottom, 'bottom', 'only-title']}>
					<div class="text-area">
						<h1 class:list={[styles.title, 'text', 'title']}><span>{bucket.title}</span></h1>
					</div>
				</div>
			</div>
		</header>
		<div class:list={[styles.prose, 'md-text', 'content']}>
			<Content components={mdxComponents} />
		</div>
	</article>
</StellarShell>
