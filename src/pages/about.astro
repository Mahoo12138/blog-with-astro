---
import StellarShell from '../layouts/StellarShell.astro';
import ArtalkComments from '../components/ArtalkComments.astro';
import { SITE_TITLE } from '../consts';
import { aboutProfile, aboutInterests, aboutSkills, aboutPersonality, aboutWriting } from '../config/about';
import * as styles from '../styles/about.css';

const readingLinks = [
	{ href: '/', label: '最新文章', external: false },
	{ href: '/columns/', label: '专栏目录', external: false },
	{ href: '/rss.xml', label: '订阅 RSS', external: false },
	{ href: aboutProfile.writingArchive, label: '写作存档', external: true },
];
const headings = [
	{ depth: 2, slug: 'about-me', text: '关于我' },
	{ depth: 2, slug: 'skills', text: '我的技能' },
	{ depth: 2, slug: 'personality', text: '性格的一面' },
	{ depth: 2, slug: 'writing', text: '可能会写的内容' },
];
---

<StellarShell
	title={`关于我 · ${SITE_TITLE}`}
	description={aboutProfile.description}
	mainClass={styles.main}
	siteTree="page"
	rightbar={['toc', 'timeline']}
	tocHeadings={headings}
>
	<article class={styles.page} aria-labelledby="about-title" data-about-page>
		<nav class={styles.breadcrumbs} aria-label="面包屑导航">
			<a href="/">首页</a><span aria-hidden="true">/</span><span aria-current="page">关于</span>
		</nav>

		<header class={styles.hero}>
			<div class={styles.heroCopy}>
				<h1 class={styles.title} id="about-title">你好，我是<span class={styles.name}>{aboutProfile.name}。</span></h1>
				<p class={styles.greeting}>{aboutProfile.greeting}</p>
				<p class={styles.introduction}>{aboutProfile.introduction}</p>
				<a class={styles.heroLink} href="#about-me">认识一下
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m-5-5 5 5 5-5" /></svg>
				</a>
			</div>
			<figure class={styles.portrait}>
				<img class={styles.illustration} src={aboutPersonality.illustration} width="400" height="400" alt="16Personalities 的 INTP 逻辑学家男性插画" loading="eager" decoding="async" data-intp-illustration />
				<figcaption class={styles.portraitCaption}><a href="#personality">{aboutPersonality.name} · {aboutPersonality.type}</a></figcaption>
			</figure>
		</header>

		<section class={styles.section} aria-labelledby="about-me">
			<h2 class={styles.sectionTitle} id="about-me">关于我</h2>
			<p class={styles.bio}>{aboutProfile.bio}</p>
			<dl class={styles.interests}>
				{aboutInterests.map((interest) => (
					<div class={styles.interest}>
						<dt>{interest.title}</dt>
						<dd>{interest.text}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class={styles.section} aria-labelledby="skills">
			<div class={styles.sectionHeading}>
				<h2 class={styles.sectionTitle} id="skills">我的技能</h2>
				<p class={styles.sectionNote}>语言、框架，以及手边的工具。</p>
			</div>
			<dl class={styles.skills}>
				{aboutSkills.map((group) => (
					<div class={styles.skillGroup} data-skill-group>
						<dt class={styles.skillLabel}>{group.title}</dt>
						<dd class={styles.skillItems}>
							<ul class={styles.skillList} role="list">{group.items.map((item) => <li>{item}</li>)}</ul>
						</dd>
					</div>
				))}
			</dl>
		</section>

		<section class:list={[styles.section, styles.personality]} aria-labelledby="personality">
			<div class={styles.personalityIntro}>
				<h2 class={styles.sectionTitle} id="personality">性格的一面</h2>
				<p class={styles.personalityType}>{aboutPersonality.type}</p>
				<p class={styles.personalityName}>{aboutPersonality.name}</p>
				<p class={styles.personalityNote}>{aboutPersonality.note}</p>
				<a class={styles.sourceLink} href={aboutPersonality.illustrationSource} target="_blank" rel="noopener noreferrer">插画来自 16Personalities<span class="sr-only">（新窗口打开）</span></a>
			</div>
			<dl class={styles.traits}>
				{aboutPersonality.traits.map((trait) => (
					<div class={styles.trait} data-personality-trait>
						<dt class={styles.traitDimension}>{trait.dimension}</dt>
						<dd class={styles.traitResult}>
							<span class={styles.traitPreference}>{trait.preference}</span>
							<span class={styles.traitValue}>{trait.value}<span>%</span></span>
						</dd>
						<dd class={styles.traitTrack}>
							<meter class={styles.meter} value={trait.value} min="0" max="100" aria-label={`${trait.dimension}：${trait.value}% ${trait.preference}`}>{trait.value}% {trait.preference}</meter>
						</dd>
					</div>
				))}
			</dl>
		</section>

		<section class:list={[styles.section, styles.closingSection]} aria-labelledby="writing">
			<h2 class={styles.sectionTitle} id="writing">可能会写的内容</h2>
			<dl class={styles.writingList}>
				{aboutWriting.map((topic) => (
					<div class={styles.writingItem}>
						<dt>{topic.title}</dt><dd>{topic.text}</dd>
					</div>
				))}
			</dl>
			<nav class={styles.readingLinks} aria-label="继续逛逛">
				{readingLinks.map((link) => (
					<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
						{link.label}{link.external && <span class="sr-only">（新窗口打开）</span>}
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
					</a>
				))}
			</nav>
		</section>
		{/* 沿用原关于页的评论 key 和开关，不因更换布局另建评论页。 */}
		<ArtalkComments pageKey={Astro.url.pathname} pageTitle="关于我" />
	</article>
</StellarShell>
