---
import BlogFeedList from '../../components/BlogFeedList.astro';
import Pagination from '../../components/Pagination.astro';
import StellarNavTabs from '../../components/StellarNavTabs.astro';
import { POSTS_PER_PAGE, SITE_TITLE } from '../../consts';
import StellarShell from '../../layouts/StellarShell.astro';
import * as styles from '../../styles/homeFeed.css';
import { buildBlogFeed, loadBlogFeedSource } from '../../utils/content';

// 与首页共用同一份博客流（独立文章 + 至多一条专栏最新更新），
// 保证两边的分页边界一致 —— 否则「下一页」会跳到读者已经看过的内容。
const { posts, columns } = await loadBlogFeedSource();
const feed = buildBlogFeed(posts, columns);
const totalPages = Math.max(1, Math.ceil(feed.length / POSTS_PER_PAGE));
const pageItems = feed.slice(0, POSTS_PER_PAGE);
const nextUrl = totalPages > 1 ? '/posts/2' : undefined;

// /posts/ 是「全部文章」的分页列表页（首页只承担最新的部分 + Hero），
// 因此 title / description 必须与首页区分，避免被判为重复内容。
const pageTitle = `全部文章 · ${SITE_TITLE}`;
const pageDescription = `${SITE_TITLE} 的全部文章归档列表，共 ${posts.length} 篇，每页 ${POSTS_PER_PAGE} 篇。`;
---

<StellarShell title={pageTitle} description={pageDescription} mainClass={styles.main} siteTree="home">
	<header class={styles.header}>
		{/* 视觉上由 NavTabs 承担标题作用，但文档需要一个 h1 作为大纲根节点，
		    否则读屏用户无法定位页面主题（Lighthouse / axe 的 page-has-heading-one）。
		    用 sr-only 保留语义、不影响设计。 */}
		<h1 class="sr-only">全部文章</h1>
		<StellarNavTabs active="home" />
	</header>
	<BlogFeedList items={pageItems} />
	<Pagination currentPage={1} totalPages={totalPages} nextUrl={nextUrl} />
</StellarShell>
