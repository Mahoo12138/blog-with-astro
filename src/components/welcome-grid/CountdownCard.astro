---
/**
 * 倒计时卡片 — 推荐 4×2
 * 左侧大字"距离 X 还有 N 天" + 右侧"今日/本周/本月/本年"进度条
 *
 * 显示规则：
 *  - 进度条 fill 按 (total - remaining) / total 计算已过比例（从左到右）
 *  - 文字默认显示百分比（已过）
 *  - 鼠标 hover 整行时，文字切换为 "还剩 {remaining} {unit}"
 *
 * 数据约定：
 *  - milestones 元素为 { label, total, remaining, unit }
 */
import type { CountdownCardProps } from '../../config/welcomeGrid';
import * as styles from '../../styles/countdownCard.css';

interface Props {
	props: CountdownCardProps;
	title?: string;
}

const { props, title } = Astro.props as Props;

function daysUntil(dateStr: string): number {
	const target = new Date(dateStr).getTime();
	const now = Date.now();
	return Math.max(0, Math.ceil((target - now) / 86_400_000));
}

const days = daysUntil(props.date);

function fillPercent(total: number, remaining: number): number {
	if (total <= 0) return 0;
	return Math.max(0, Math.min(100, ((total - remaining) / total) * 100));
}
---

<div
	class={styles.card}
	data-welcome-card="countdown"
	data-countdown-date={props.date}
	title={title ?? `${props.title} ${days} 天`}
>
	<div class={styles.leftCol}>
		<p class={styles.title}>{props.title}</p>
		<p class={styles.dayNumber} data-countdown-days>{days}</p>
		<p class={styles.dateLabel}>{props.dateLabel ?? props.date}</p>
	</div>
	<div class={styles.list}>
		{
			props.milestones.map((m) => {
				const pct = fillPercent(m.total, m.remaining);
				return (
					<div class={styles.row}>
						<span class={styles.label}>{m.label}</span>
						<div
							class={styles.track}
							role="progressbar"
							aria-valuemin={0}
							aria-valuemax={m.total}
							aria-valuenow={m.total - m.remaining}
							aria-label={`${m.label} 还剩 ${m.remaining} ${m.unit}`}
						>
							<div class={styles.fill} style={`width:${pct.toFixed(2)}%`} />
							<span class={styles.textLayer}>
								<span class={styles.percent}>{pct.toFixed(2)}%</span>
								<span class={styles.remaining}>还剩 {m.remaining} {m.unit}</span>
							</span>
						</div>
					</div>
				);
			})
		}
	</div>
</div>

<script is:inline>
	// 倒计时实时刷新：每分钟重算剩余天数（仅更新"距离 X"主数字）
	(() => {
		const widget = document.currentScript?.previousElementSibling;
		if (!widget) return;
		const dayEl = widget.querySelector('[data-countdown-days]');
		const target = new Date(widget.getAttribute('data-countdown-date') || '').getTime();
		if (!dayEl || !target) return;

		function tick() {
			const days = Math.max(0, Math.ceil((target - Date.now()) / 86400000));
			dayEl.textContent = String(days);
		}
		tick();
		const id = setInterval(tick, 60_000);
		document.addEventListener('astro:before-swap', () => clearInterval(id), { once: true });
	})();
</script>
