---
import { getCollection } from "astro:content";
import { getExploreInternalItemByHref } from "../config/explore";
import ExploreShell from "../layouts/ExploreShell.astro";

// Presentational Astro components
import LoveHero from "../components/love/LoveHero.astro";
import LoveTimeline from "../components/love/LoveTimeline.astro";
import LoveGallery from "../components/love/LoveGallery.astro";
import LoveFirsts from "../components/love/LoveFirsts.astro";
import LoveTraits from "../components/love/LoveTraits.astro";
import LoveDestinations from "../components/love/LoveDestinations.astro";
import LovePromises from "../components/love/LovePromises.astro";
import LoveNotes from "../components/love/LoveNotes.astro";
import LoveLetter from "../components/love/LoveLetter.astro";
import LoveFooter from "../components/love/LoveFooter.astro";
import LoveDivider from "../components/love/LoveDivider.astro";

// Interactive React islands
import LoveParticles from "../components/love/LoveParticles";
import LoveInteractions from "../components/love/LoveInteractions";
import LoveCountdown from "../components/love/LoveCountdown";
import LoveStats from "../components/love/LoveStats";
import LoveWishes from "../components/love/LoveWishes";
import LoveSong from "../components/love/LoveSong";
import LoveCalendar from "../components/love/LoveCalendar";

const item = getExploreInternalItemByHref("/love/");

if (!item) {
  throw new Error("Explore item for /love/ was not found.");
}

const sortById = <T extends { id: string }>(entries: T[]) =>
  [...entries].sort((a, b) => a.id.localeCompare(b.id));

const [
  timeline,
  photos,
  firsts,
  stats,
  traits,
  destinations,
  wishes,
  promises,
  calendar,
  loveNotes,
] = await Promise.all([
  getCollection("loveTimeline"),
  getCollection("lovePhotos"),
  getCollection("loveFirsts"),
  getCollection("loveStats"),
  getCollection("loveTraits"),
  getCollection("loveDestinations"),
  getCollection("loveWishes"),
  getCollection("lovePromises"),
  getCollection("loveCalendar"),
  getCollection("loveNotes"),
]);

const meta = {
  startDate: "2025-12-06",
  anniversaryDate: "2026-12-06",
  anniversaryLabel: "一周年 · 2026.12.06",
  partners: {
    left: { initial: "他", name: "隐隐控", avatar: "/avatars/inin-kon.jpg" },
    right: { initial: "她", name: "隐隐", avatar: "/avatars/inin.png" },
  },
  song: {
    title: "光年之外",
    artist: "G.E.M. 邓紫棋",
    note: '"第一次牵手的那天，这首歌刚好在播。"',
    initialTime: "1:23",
    totalTime: "3:43",
    initialPercent: 37,
  },
  letter: {
    date: "2026 · 05 · 20",
    greeting: "亲爱的你，",
    paragraphs: [
      "想对你说的话有很多，却总是不知道从哪里开始。",
      "喜欢你不是因为某一件事，而是你所有细小的样子加在一起，刚好成了我最想靠近的人。",
      '喜欢你认真讲话时的样子，喜欢你笑起来的样子，喜欢你说"我知道了"却还是会忘记的样子。',
      "谢谢你愿意留在我身边，谢谢你让我相信，平凡的日子也可以这么闪光。",
      "希望我们可以一直这样下去，把所有的四季都过一遍，再过一遍。",
    ],
    signature: "— 永远爱你的我 ♡",
  },
};

const month = new Date().getMonth() + 1;
const currentSeason =
  month >= 3 && month <= 5
    ? "spring"
    : month >= 6 && month <= 8
      ? "summer"
      : month >= 9 && month <= 11
        ? "autumn"
        : "winter";

const timelineEntries = sortById(timeline);
const photoEntries = sortById(photos);
const firstsEntries = sortById(firsts);
const traitsEntries = sortById(traits);
const destinationsEntries = sortById(destinations);
const promisesEntries = sortById(promises);
const notesEntries = sortById(loveNotes);

// Map to plain objects for React island props
const statsEntries = sortById(stats).map((e) => ({ id: e.id, ...e.data }));
const wishesEntries = sortById(wishes).map((e) => ({ id: e.id, ...e.data }));
const calendarEntries = sortById(calendar).map((e) => ({ id: e.id, ...e.data }));
---

<ExploreShell item={item}>
  <div class="love-root" data-season={currentSeason} id="love-root">
    <!-- Critical: load immediately -->
    <LoveParticles season={currentSeason} client:load />
    <LoveInteractions client:load />

    <LoveHero left={meta.partners.left} right={meta.partners.right} />

    <LoveCountdown
      client:load
      startDate={meta.startDate}
      anniversaryDate={meta.anniversaryDate}
      anniversaryLabel={meta.anniversaryLabel}
      daysText="在一起的时光"
    />
    <!-- <LoveDivider icon="✦" /> -->
    <!-- <LoveDivider icon="◇" /> -->

    <LoveTimeline entries={timelineEntries} />

    <LoveGallery entries={photoEntries} />

    <LoveFirsts entries={firstsEntries} />

    <LoveStats entries={statsEntries} client:visible />

    <LoveTraits entries={traitsEntries} />

    <!-- <LoveSong song={meta.song} client:idle /> -->

    <LoveDestinations entries={destinationsEntries} />

    <LoveWishes entries={wishesEntries} client:idle />

    <LovePromises entries={promisesEntries} />

    <LoveCalendar entries={calendarEntries} client:visible />

    <LoveNotes entries={notesEntries} />

    <LoveLetter letter={meta.letter} />

    <LoveFooter startDate={meta.startDate} />
  </div>

  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600&family=Noto+Sans+SC:wght@300;400;500&display=swap");

    main:has(> .love-root) {
      animation: none !important;
      transform: none !important;
    }

    /* ── SEASON VARS ─ */
    .love-root[data-season="spring"] {
      --bg: #0d0408;
      --bg2: #180812;
      --sf: rgba(220, 80, 110, 0.07);
      --gw: #e8547a;
      --gw2: #ff90b4;
      --gd: rgba(232, 84, 122, 0.1);
      --gd2: rgba(232, 84, 122, 0.22);
      --tx: #ffe8f2;
      --txm: rgba(255, 232, 242, 0.56);
      --txh: rgba(255, 232, 242, 0.28);
      --bd: rgba(232, 84, 122, 0.2);
      --bds: rgba(232, 84, 122, 0.42);
    }
    .love-root[data-season="summer"] {
      --bg: #0a0702;
      --bg2: #150f04;
      --sf: rgba(210, 140, 20, 0.07);
      --gw: #e8a020;
      --gw2: #ffca60;
      --gd: rgba(232, 160, 32, 0.1);
      --gd2: rgba(232, 160, 32, 0.22);
      --tx: #fff8e8;
      --txm: rgba(255, 248, 232, 0.56);
      --txh: rgba(255, 248, 232, 0.28);
      --bd: rgba(232, 160, 32, 0.2);
      --bds: rgba(232, 160, 32, 0.42);
    }
    .love-root[data-season="autumn"] {
      --bg: #0c0502;
      --bg2: #180806;
      --sf: rgba(200, 80, 20, 0.07);
      --gw: #e06028;
      --gw2: #ff9058;
      --gd: rgba(224, 96, 40, 0.1);
      --gd2: rgba(224, 96, 40, 0.22);
      --tx: #fff0e8;
      --txm: rgba(255, 240, 232, 0.56);
      --txh: rgba(255, 240, 232, 0.28);
      --bd: rgba(224, 96, 40, 0.2);
      --bds: rgba(224, 96, 40, 0.42);
    }
    .love-root[data-season="winter"] {
      --bg: #030810;
      --bg2: #061020;
      --sf: rgba(40, 100, 220, 0.07);
      --gw: #3c80ff;
      --gw2: #80b8ff;
      --gd: rgba(60, 128, 255, 0.1);
      --gd2: rgba(60, 128, 255, 0.22);
      --tx: #e8f2ff;
      --txm: rgba(232, 242, 255, 0.56);
      --txh: rgba(232, 242, 255, 0.28);
      --bd: rgba(60, 128, 255, 0.2);
      --bds: rgba(60, 128, 255, 0.42);
    }

    .love-root {
      position: relative;
      font-family: "Noto Sans SC", system-ui, sans-serif;
      background: var(--bg);
      color: var(--tx);
      line-height: 1.7;
      transition:
        background 0.7s,
        color 0.7s;
      overflow-x: hidden;
      min-height: 100vh;
    }
    .love-root *,
    .love-root *::before,
    .love-root *::after {
      box-sizing: border-box;
    }
    .love-root #bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.45;
    }
    .love-root #prog {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(90deg, var(--gw), var(--gw2));
      z-index: 200;
      transition: background 0.7s;
    }
    .love-root #cg {
      position: fixed;
      width: 340px;
      height: 340px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      transform: translate(-50%, -50%);
      background: radial-gradient(circle, var(--gd2) 0%, transparent 65%);
      mix-blend-mode: screen;
      opacity: 0.65;
      transition: background 0.7s;
      will-change: transform;
    }

    /* SCROLL ANIM */
    .love-root .a0 {
      opacity: 0;
      transform: translateY(30px);
      transition:
        opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .love-root .al {
      opacity: 0;
      transform: translateX(-26px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .love-root .ar {
      opacity: 0;
      transform: translateX(26px);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .love-root .sc2 {
      opacity: 0;
      transform: scale(0.88);
      transition:
        opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .love-root .a0.v,
    .love-root .al.v,
    .love-root .ar.v,
    .love-root .sc2.v {
      opacity: 1;
      transform: none;
    }
    .love-root .d1 { transition-delay: 0.07s; }
    .love-root .d2 { transition-delay: 0.14s; }
    .love-root .d3 { transition-delay: 0.21s; }
    .love-root .d4 { transition-delay: 0.28s; }
    .love-root .d5 { transition-delay: 0.35s; }
    .love-root .d6 { transition-delay: 0.42s; }
    .love-root .d7 { transition-delay: 0.49s; }
    .love-root .d8 { transition-delay: 0.56s; }
    .love-root .d9 { transition-delay: 0.63s; }

    /* SECTIONS */
    .love-root .sec {
      padding: 6rem 2rem;
      position: relative;
      overflow: hidden;
    }
    .love-root .sec-in {
      max-width: 960px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }
    .love-root .sec::before {
      content: "";
      position: absolute;
      border-radius: 50%;
      width: 500px;
      height: 400px;
      filter: blur(130px);
      background: var(--gd);
      opacity: 0.18;
      pointer-events: none;
      z-index: 0;
      top: 50%;
      transform: translateY(-50%);
    }
    .love-root .sec:nth-of-type(odd)::before {
      left: -160px;
    }
    .love-root .sec:nth-of-type(even)::before {
      right: -160px;
      left: auto;
    }

    /* DIVIDER */
    .love-root .div {
      display: flex;
      align-items: center;
      gap: 16px;
      max-width: 960px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .love-root .div-l {
      flex: 1;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        var(--bds) 30%,
        var(--bd) 70%,
        transparent
      );
    }
    .love-root .div-ic {
      font-size: 13px;
      color: var(--gw);
      opacity: 0.45;
      flex-shrink: 0;
      transition: color 0.7s;
    }

    /* SECTION HEADER */
    .love-root .sh {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 2.5rem;
    }
    .love-root .sh h2 {
      font-family: "Noto Serif SC", serif;
      font-size: 20px;
      font-weight: 600;
      white-space: nowrap;
      background: linear-gradient(135deg, var(--gw2), var(--tx));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin: 0;
    }
    .love-root .sh-l {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--bds), transparent);
      transition: background 0.7s;
    }
    .love-root .sh-l.r {
      background: linear-gradient(90deg, transparent, var(--bds));
    }
    .love-root .sh-tag {
      font-size: 11px;
      color: var(--gw);
      border: 1px solid var(--bd);
      padding: 2px 10px;
      border-radius: 20px;
      background: var(--gd);
      white-space: nowrap;
      flex-shrink: 0;
      transition: all 0.7s;
    }

    /* GLASS */
    .love-root .glass {
      background: var(--sf);
      border: 1px solid var(--bd);
      border-radius: 16px;
      transition:
        border-color 0.3s,
        box-shadow 0.3s,
        transform 0.3s;
    }
    .love-root .glass:hover {
      border-color: var(--bds);
      box-shadow: 0 0 28px var(--gd);
    }
    .love-root .tilt {
      transform-style: preserve-3d;
    }

    /* ── COUNTDOWN ── */
    .love-root .cd-main {
      text-align: center;
      padding: 3rem 2rem;
    }
    .love-root .cd-from {
      font-size: 12px;
      color: var(--txh);
      margin-bottom: 1.5rem;
      letter-spacing: 0.06em;
    }
    .love-root .cd-row {
      display: flex;
      justify-content: center;
      align-items: flex-end;
      gap: 4px;
      flex-wrap: wrap;
    }
    .love-root .cd-blk {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .love-root .cd-n {
      font-family: "Noto Serif SC", serif;
      font-size: clamp(40px, 9vw, 72px);
      font-weight: 600;
      color: var(--gw2);
      line-height: 1;
      min-width: 2ch;
      text-shadow: 0 0 30px var(--gd2);
      transition: color 0.7s, text-shadow 0.7s;
    }
    .love-root .cd-u {
      font-size: 12px;
      color: var(--txh);
    }
    .love-root .cd-dot {
      font-family: "Noto Serif SC", serif;
      font-size: 36px;
      color: var(--bd);
      margin-bottom: 6px;
      transition: color 0.7s;
    }
    .love-root .cd-cap {
      font-size: 14px;
      color: var(--txm);
      margin-top: 1.5rem;
    }
    .love-root .cd-cap strong {
      color: var(--gw2);
      text-shadow: 0 0 14px var(--gd2);
      transition: all 0.7s;
    }
    .love-root .cd-nx {
      margin-top: 1.5rem;
      display: inline-flex;
      align-items: center;
      gap: 20px;
      background: var(--gd);
      border: 1px solid var(--bd);
      border-radius: 50px;
      padding: 0.75rem 2rem;
      transition: all 0.7s;
    }
    .love-root .cdl .a {
      font-size: 11px;
      color: var(--txh);
      margin-bottom: 2px;
    }
    .love-root .cdl .b {
      font-size: 13px;
      color: var(--txm);
    }
    .love-root .cdr .n {
      font-family: "Noto Serif SC", serif;
      font-size: 24px;
      font-weight: 600;
      color: var(--gw2);
      text-shadow: 0 0 14px var(--gd2);
      transition: all 0.7s;
      text-align: right;
    }
    .love-root .cdr .u {
      font-size: 11px;
      color: var(--txh);
      text-align: right;
    }

    /* ── STATS ── */
    .love-root .sg {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    @media (max-width: 580px) {
      .love-root .sg {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .love-root .sc3 {
      padding: 1.25rem 0.75rem;
      text-align: center;
      border-radius: 14px;
      cursor: default;
    }
    .love-root .sc3-ic {
      font-size: 22px;
      margin-bottom: 8px;
    }
    .love-root .sc3-n {
      font-family: "Noto Serif SC", serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--gw2);
      text-shadow: 0 0 16px var(--gd2);
      transition: color 0.7s, text-shadow 0.7s;
    }
    .love-root .sc3-l {
      font-size: 11px;
      color: var(--txh);
      margin-top: 4px;
    }

    /* ── WISHLIST ── */
    .love-root .wl {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .love-root .wi {
      display: flex;
      align-items: center;
      gap: 14px;
      border-radius: 12px;
      padding: 12px 16px;
      cursor: pointer;
      user-select: none;
      transition: all 0.25s;
    }
    .love-root .wi:hover {
      border-color: var(--bds) !important;
      box-shadow: 0 0 16px var(--gd);
    }
    .love-root .wi.dn {
      opacity: 0.6;
    }
    .love-root .wc {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid var(--bd);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 12px;
      color: transparent;
      transition: all 0.25s;
    }
    .love-root .wi.dn .wc {
      background: var(--gw);
      border-color: var(--gw);
      color: #fff;
      box-shadow: 0 0 10px var(--gd2);
    }
    .love-root .wt {
      flex: 1;
      font-size: 14px;
      color: var(--tx);
    }
    .love-root .wi.dn .wt {
      text-decoration: line-through;
      color: var(--txh);
    }
    .love-root .wk {
      font-size: 11px;
      padding: 2px 9px;
      border-radius: 10px;
      border: 1px solid var(--bd);
      color: var(--txh);
      background: var(--gd);
      flex-shrink: 0;
      transition: all 0.7s;
    }
    .love-root .wi.dn .wk {
      border-color: var(--bds);
      color: var(--gw2);
    }

    /* ── SONG ── */
    .love-root .song-wrap {
      border-radius: 20px;
      overflow: hidden;
    }
    .love-root .song-hd {
      height: 4px;
      background: linear-gradient(90deg, var(--gw), var(--gw2), var(--gw));
      background-size: 200%;
      animation: loveShim 3s linear infinite;
      transition: background 0.7s;
    }
    @keyframes loveShim {
      0% { background-position: 200%; }
      100% { background-position: -200%; }
    }
    .love-root .song-bd {
      padding: 2rem 1.75rem 1.25rem;
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .love-root .song-art {
      width: 80px;
      height: 80px;
      border-radius: 14px;
      background: linear-gradient(135deg, var(--gd2), var(--gd));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      flex-shrink: 0;
      border: 1px solid var(--bd);
      box-shadow: 0 0 24px var(--gd);
      transition: all 0.7s;
    }
    .love-root .song-inf .t {
      font-weight: 500;
      font-size: 17px;
      color: var(--tx);
      margin-bottom: 3px;
    }
    .love-root .song-inf .ar {
      font-size: 13px;
      color: var(--txm);
    }
    .love-root .song-inf .nt {
      font-size: 12px;
      color: var(--txh);
      font-style: italic;
      margin-top: 5px;
      line-height: 1.6;
    }
    .love-root .song-ft {
      padding: 0 1.75rem 1.5rem;
    }
    .love-root .sb {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
    }
    .love-root .str {
      flex: 1;
      height: 3px;
      background: var(--bd);
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.7s;
    }
    .love-root .sfl {
      height: 100%;
      border-radius: 2px;
      background: linear-gradient(90deg, var(--gw), var(--gw2));
      transition: background 0.7s;
    }
    .love-root .stm {
      font-size: 11px;
      color: var(--txh);
    }
    .love-root .sct {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
    }
    .love-root .sbt {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--bd);
      background: none;
      cursor: pointer;
      font-size: 14px;
      color: var(--txm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.25s;
    }
    .love-root .sbt:hover {
      border-color: var(--gw);
      color: var(--gw2);
      box-shadow: 0 0 12px var(--gd);
    }
    .love-root .sbt.pl {
      width: 44px;
      height: 44px;
      background: var(--gw);
      border-color: var(--gw);
      color: #fff;
      font-size: 17px;
      box-shadow: 0 0 20px var(--gd2);
      transition: all 0.7s;
    }

    /* ── CALENDAR ── */
    .love-root .cal-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }
    .love-root .cal-card {
      width: 100%;
      max-width: 440px;
      border-radius: 20px;
      position: relative;
      overflow: hidden;
      padding-top: 2.5rem;
    }
    .love-root .cal-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 15%, var(--gd2), transparent 60%);
      pointer-events: none;
    }
    .love-root .cal-rings {
      display: flex;
      justify-content: center;
      gap: 20px;
