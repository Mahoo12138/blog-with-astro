---
import StellarIcon from './StellarIcon.astro';
import StellarSearchModal from './StellarSearchModal.astro';
import * as styles from './StellarNavTabs.css';

interface Item {
	label: string;
	href?: string;
	key: string;
}

interface Props {
	active: string;
}

const { active } = Astro.props;

const items: Item[] = [
	{ key: 'home', label: '博客', href: '/posts/' },
	{ key: 'categories', label: '分类', href: '/categories' },
	{ key: 'tags', label: '标签', href: '/tags' },
	{ key: 'columns', label: '专栏', href: '/columns' },
	{ key: 'archives', label: '归档', href: '/archives' },
];
---

<div class={styles.root}>
	<div class={styles.blur}>
		<div class={styles.inner}>
			<nav class={styles.nav} aria-label="Sections">
				{
					items.map((item) => (
						<a class:list={[styles.item, active === item.key && styles.active]} href={item.href}>
							{item.label}
						</a>
					))
				}
			</nav>
			{/* kbar 式命令面板触发器：搜索文章、跳转页面、切换主题，⌘K 亦可全局唤起。 */}
			<button class={styles.searchTrigger} type="button" data-search-open title="搜索或命令（⌘K）" aria-label="搜索或命令">
				<StellarIcon name="default:search" class={styles.searchTriggerIcon} />
				<span class={styles.searchTriggerText}>搜索或命令</span>
				<kbd class={styles.searchTriggerKbd} data-search-kbd-hint>⌘K</kbd>
			</button>
		</div>
	</div>
</div>

<StellarSearchModal />