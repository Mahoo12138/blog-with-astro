---
import type { WidgetProps } from './types';
import * as styles from './welcome.css';

const { widget } = Astro.props as WidgetProps;
---

<section class={styles.note} data-welcome-note aria-label={widget.title}>
	<h2 class={styles.title}>{widget.title}</h2>
	<p class={styles.text}>{widget.body}</p>
</section>
